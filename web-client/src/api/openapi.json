{
  "openapi": "3.1.0",
  "info": {
    "title": "天道不正经 M5 卡牌肉鸽 API",
    "version": "2.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "description": "返回进程健康状态；无入参、无存储副作用。",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/catalog": {
      "get": {
        "summary": "Catalog",
        "description": "返回完整卡牌、法宝、敌人与流派目录；无存储副作用。",
        "operationId": "catalog_api_v2_catalog_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/runs": {
      "post": {
        "summary": "Create Run",
        "description": "创建匿名局面；可用既有 Bearer 归属同档案，错误凭证返回 401。",
        "operationId": "create_run_api_v2_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateRunResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v2/runs/{run_id}": {
      "get": {
        "summary": "Get Run",
        "description": "读取 Bearer 所属权威局面；无写副作用，缺失或错误凭证返回 401。",
        "operationId": "get_run_api_v2_runs__run_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/runs/{run_id}/actions": {
      "post": {
        "summary": "Perform Action",
        "description": "原子提交类型化动作；成功推进 revision，非法动作不落盘。",
        "operationId": "perform_action_api_v2_runs__run_id__actions_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActionRequest": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ChooseNodeAction"
          },
          {
            "$ref": "#/components/schemas/PlayCardAction"
          },
          {
            "$ref": "#/components/schemas/EndTurnAction"
          },
          {
            "$ref": "#/components/schemas/TauntAction"
          },
          {
            "$ref": "#/components/schemas/ChooseRewardAction"
          },
          {
            "$ref": "#/components/schemas/SkipRewardAction"
          },
          {
            "$ref": "#/components/schemas/ChooseEventAction"
          },
          {
            "$ref": "#/components/schemas/BuyAction"
          },
          {
            "$ref": "#/components/schemas/RemoveCardAction"
          },
          {
            "$ref": "#/components/schemas/RestAction"
          },
          {
            "$ref": "#/components/schemas/UpgradeCardAction"
          },
          {
            "$ref": "#/components/schemas/LeaveShopAction"
          }
        ],
        "title": "ActionRequest",
        "description": "扁平动作 JSON 的判别联合根模型。",
        "discriminator": {
          "propertyName": "kind",
          "mapping": {
            "buy": "#/components/schemas/BuyAction",
            "choose_event": "#/components/schemas/ChooseEventAction",
            "choose_node": "#/components/schemas/ChooseNodeAction",
            "choose_reward": "#/components/schemas/ChooseRewardAction",
            "end_turn": "#/components/schemas/EndTurnAction",
            "leave_shop": "#/components/schemas/LeaveShopAction",
            "play_card": "#/components/schemas/PlayCardAction",
            "remove_card": "#/components/schemas/RemoveCardAction",
            "rest": "#/components/schemas/RestAction",
            "skip_reward": "#/components/schemas/SkipRewardAction",
            "taunt": "#/components/schemas/TauntAction",
            "upgrade_card": "#/components/schemas/UpgradeCardAction"
          }
        }
      },
      "ArchetypeDefinition": {
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "sword",
              "fire",
              "talisman"
            ],
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "starter_card_id": {
            "type": "string",
            "title": "Starter Card Id"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "starter_card_id"
        ],
        "title": "ArchetypeDefinition"
      },
      "BuyAction": {
        "properties": {
          "action_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Action Id"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Revision"
          },
          "kind": {
            "type": "string",
            "const": "buy",
            "title": "Kind"
          },
          "item_id": {
            "type": "string",
            "title": "Item Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action_id",
          "expected_revision",
          "kind",
          "item_id"
        ],
        "title": "BuyAction"
      },
      "CardDefinition": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "archetype": {
            "type": "string",
            "enum": [
              "common",
              "sword",
              "fire",
              "talisman"
            ],
            "title": "Archetype"
          },
          "cost": {
            "type": "integer",
            "title": "Cost"
          },
          "upgraded_cost": {
            "type": "integer",
            "title": "Upgraded Cost"
          },
          "target": {
