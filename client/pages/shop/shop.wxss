/**
 * 黑市页面 — 暗域交易所
 */

.page {
  height: 100vh;
  background:
    radial-gradient(ellipse 60% 60% at 50% 40%, rgba(20, 28, 50, 0.6) 0%, transparent 70%),
    radial-gradient(ellipse 40% 30% at 20% 80%, rgba(22, 26, 43, 0.4) 0%, transparent 50%),
    var(--ink-black);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

/* 暗纹帷幕 */
.bg-veil {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  background:
    repeating-linear-gradient(
      0deg,
      transparent,
      transparent 4rpx,
      rgba(120, 100, 60, 0.01) 4rpx,
      rgba(120, 100, 60, 0.01) 6rpx
    );
}

/* ── 容器 ── */
.teaser-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 40rpx;
  position: relative;
  z-index: 1;
}

/* ── 符文圆环 ── */
.rune-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(200, 160, 80, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  position: relative;
  animation: gold-breath 4s ease-in-out infinite;
}

.rune-circle::before {
  content: "";
  position: absolute;
  top: -4rpx;
  left: -4rpx;
  right: -4rpx;
  bottom: -4rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(200, 160, 80, 0.08);
}

.rune-inner {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(22, 26, 43, 0.9), var(--paper-dark));
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(200, 160, 80, 0.3);
}

.rune-glyph {
  font-size: 56rpx;
  color: var(--gold-leaf);
  opacity: 0.7;
}

/* ── 标题 ── */
.teaser-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.teaser-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--gold-pale);
  letter-spacing: 16rpx;
}

.teaser-subtitle {
  font-size: 22rpx;
  color: var(--text-mist-dim);
  letter-spacing: 6rpx;
}

/* ── 分隔 ── */
.divider-rune {
  margin-bottom: 24rpx;
}

.divider-line {
  font-size: 24rpx;
  color: rgba(200, 160, 80, 0.2);
  letter-spacing: 8rpx;
}

/* ── 描述 ── */
.teaser-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 40rpx;
}

.teaser-desc {
  font-size: 28rpx;
  color: var(--text-mist);
  letter-spacing: 4rpx;
}

.teaser-hint {
  font-size: 24rpx;
  color: var(--text-mist-dim);
  letter-spacing: 2rpx;
  animation: qi-pulse 3s ease-in-out infinite;
}

/* ── 预示商品 ── */
.foreshadow-items {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  width: 100%;
}

.foreshadow-item {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: rgba(22, 26, 43, 0.5);
  border: 1rpx solid var(--border-ink-light);
  border-radius: var(--radius-sm);
  gap: 16rpx;
}

.fs-icon {
  font-size: 36rpx;
  opacity: 0.6;
}

.fs-name {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-mist);
  letter-spacing: 2rpx;
}

.fs-tag {
  font-size: 20rpx;
  color: var(--text-mist-dim);
  padding: 4rpx 12rpx;
  border: 1rpx solid var(--border-ink);
  border-radius: 4rpx;
  letter-spacing: 2rpx;
}
