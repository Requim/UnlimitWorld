/**
 * 挂机修炼页面 — 水墨宇宙风格
 */

/* ═══════════════════════════════════════════
   页面容器
   ═══════════════════════════════════════════ */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background:
    linear-gradient(180deg, rgba(13, 16, 18, 0.12), rgba(13, 16, 18, 0.92)),
    radial-gradient(ellipse 86% 38% at 50% 100%, rgba(91, 72, 45, 0.46) 0%, transparent 66%),
    radial-gradient(ellipse 64% 36% at 15% 12%, rgba(118, 37, 30, 0.26) 0%, transparent 64%),
    linear-gradient(180deg, #1d211f 0%, #111614 50%, #090d0c 100%);
  position: relative;
  overflow: hidden;
}

/* 页面暗纹纹理 */
.page::before {
  content: "";
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 46vh;
  pointer-events: none;
  z-index: 0;
  background:
    linear-gradient(153deg, transparent 0 26%, rgba(28, 36, 33, 0.58) 27% 35%, transparent 36%),
    linear-gradient(28deg, transparent 0 34%, rgba(40, 47, 40, 0.66) 35% 45%, transparent 46%),
    linear-gradient(145deg, transparent 0 46%, rgba(88, 71, 46, 0.36) 47% 54%, transparent 55%),
    linear-gradient(180deg, transparent 0%, rgba(5, 8, 8, 0.82) 82%);
}

.page::after {
  content: "";
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
  background:
    repeating-linear-gradient(90deg, transparent, transparent 4rpx, rgba(223, 196, 132, 0.024) 4rpx, rgba(223, 196, 132, 0.024) 6rpx),
    radial-gradient(circle at 50% 18%, rgba(221, 170, 82, 0.08), transparent 44%);
}

/* ═══════════════════════════════════════════
   状态栏 — 修仙六维面板
   ═══════════════════════════════════════════ */
.status-bar {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 10rpx 12rpx 12rpx;
  background:
    linear-gradient(180deg, rgba(23, 24, 21, 0.96), rgba(35, 28, 22, 0.92)),
    linear-gradient(90deg, rgba(191, 143, 64, 0.12), transparent 40%, rgba(176, 51, 38, 0.1));
  border-bottom: 1rpx solid rgba(211, 166, 87, 0.22);
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.status-grid {
  display: flex;
  flex-wrap: nowrap;
  justify-content: space-between;
  gap: 6rpx;
  width: 100%;
}

/* 底边金线灵气 */
.status-bar::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 10%;
  width: 80%;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(200, 160, 80, 0.2), rgba(200, 160, 80, 0.5), rgba(200, 160, 80, 0.2), transparent);
}

.status-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 0;
  padding: 4rpx 2rpx;
  position: relative;
}

.status-label {
  font-size: 18rpx;
  color: rgba(210, 190, 148, 0.62);
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.status-value {
  max-width: 100%;
  margin-top: 2rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #d8b46d;
  letter-spacing: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 天谴值 — 朱砂色 */
.status-sin {
  color: var(--cinnabar) !important;
}

/* 天谴满值时脉动警告 */
.status-sin.danger {
  animation: cinnabar-pulse 1.2s ease-in-out infinite;
}

/* M3：天谴进度条 — 朱砂火脉 */
.sin-gauge {
  width: 100%;
  padding: 0 4rpx 2rpx;
  box-sizing: border-box;
  position: relative;
}

.sin-gauge-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.sin-gauge-label {
  font-size: 20rpx;
  color: rgba(210, 190, 148, 0.66);
  letter-spacing: 3rpx;
}

.sin-gauge-value {
  font-size: 22rpx;
  color: var(--cinnabar);
  font-weight: 700;
  letter-spacing: 2rpx;
}

.sin-track {
  height: 14rpx;
  border: 1rpx solid rgba(170, 58, 47, 0.52);
  border-radius: 4rpx;
  background:
    linear-gradient(90deg, rgba(34, 28, 22, 0.96), rgba(72, 54, 37, 0.9)),
    #1e1814;
  overflow: hidden;
  position: relative;
  box-shadow: inset 0 0 12rpx rgba(128, 112, 88, 0.14);
}

.sin-fill {
  height: 100%;
  min-width: 2rpx;
  background: linear-gradient(90deg, var(--cinnabar-dark), var(--cinnabar), var(--cinnabar-bright));
  border-radius: 3rpx;
  box-shadow: 0 0 18rpx rgba(212, 61, 61, 0.38);
  transition: width 0.45s ease-out;
  position: relative;
}

.sin-fill::after {
  content: "";
  position: absolute;
  right: -6rpx;
  top: -8rpx;
  width: 20rpx;
  height: 30rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(240, 74, 74, 0.65), transparent 70%);
  animation: sin-flame 0.9s ease-in-out infinite;
}

.sin-ember {
  position: absolute;
  bottom: -6rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: rgba(240, 74, 74, 0.8);
  opacity: 0;
}

.ember-a { left: 24%; animation: ember-rise 1.9s ease-in-out infinite; }
.ember-b { left: 56%; animation: ember-rise 2.4s ease-in-out 0.3s infinite; }
.ember-c { left: 82%; animation: ember-rise 1.6s ease-in-out 0.7s infinite; }

.sin-gauge.warning .sin-track {
  border-color: rgba(200, 160, 80, 0.45);
}

.sin-gauge.danger .sin-track {
  animation: sin-track-tremor 0.7s ease-in-out infinite;
  border-color: rgba(240, 74, 74, 0.75);
  box-shadow:
    inset 0 0 12rpx rgba(128, 112, 88, 0.14),
    0 0 24rpx rgba(212, 61, 61, 0.24);
}

/* ═══════════════════════════════════════════
   内容区
   ═══════════════════════════════════════════ */
.content-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
  z-index: 1;
}

.center-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 36rpx;
  position: relative;
  z-index: 1;
}

/* ═══════════════════════════════════════════
   状态 1：连接中
   ═══════════════════════════════════════════ */

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.meditation-loader {
  width: 280rpx;
  height: 280rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.meditation-aura {
  position: absolute;
  border-radius: 50%;
  border-style: solid;
  border-color: rgba(120, 110, 94, 0.18);
  opacity: 0.95;
}

.aura-outer {
  width: 238rpx;
  height: 238rpx;
  border-width: 2rpx;
  animation: aura-spin 6.5s linear infinite;
}

.aura-inner {
  width: 182rpx;
  height: 182rpx;
  border-width: 1rpx;
  border-top-color: rgba(201, 160, 80, 0.6);
  border-bottom-color: rgba(201, 160, 80, 0.26);
  animation: aura-spin 3.8s linear reverse infinite;
}

.cultivator {
  width: 170rpx;
  height: 170rpx;
  position: relative;
  filter: drop-shadow(0 12rpx 24rpx rgba(110, 102, 89, 0.12));
}

.cultivator-head {
  position: absolute;
  top: 26rpx;
  left: 66rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, rgba(88, 88, 92, 0.92), rgba(43, 43, 49, 0.96));
  box-shadow: inset 0 -4rpx 0 rgba(255, 255, 255, 0.08);
}

.cultivator-body {
  position: absolute;
  top: 62rpx;
  left: 52rpx;
  width: 66rpx;
  height: 52rpx;
  background: linear-gradient(180deg, rgba(72, 76, 82, 0.94), rgba(112, 118, 124, 0.88));
  border-radius: 42rpx 42rpx 26rpx 26rpx;
}

.cultivator-arm,
.cultivator-leg {
  position: absolute;
  background: linear-gradient(180deg, rgba(92, 96, 102, 0.9), rgba(58, 60, 66, 0.94));
}

.cultivator-arm {
  top: 86rpx;
  width: 46rpx;
  height: 14rpx;
  border-radius: 20rpx;
}

.arm-left {
  left: 30rpx;
  transform: rotate(18deg);
}

.arm-right {
  right: 30rpx;
  transform: rotate(-18deg);
}

.cultivator-leg {
  top: 114rpx;
  width: 60rpx;
  height: 24rpx;
  border-radius: 24rpx;
}

.leg-left {
  left: 26rpx;
  transform: rotate(18deg);
}

.leg-right {
  right: 26rpx;
  transform: rotate(-18deg);
}

.cultivator-cushion {
  position: absolute;
  bottom: 20rpx;
  left: 24rpx;
  width: 122rpx;
  height: 24rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 40%, rgba(240, 235, 224, 0.95), rgba(199, 184, 160, 0.92) 68%, rgba(160, 146, 123, 0.9));
  box-shadow:
    0 8rpx 18rpx rgba(132, 118, 95, 0.16),
    inset 0 2rpx 8rpx rgba(255, 255, 255, 0.32);
}

.loading-text {
  font-size: 32rpx;
  color: var(--text-mist);
  letter-spacing: 4rpx;
  animation: qi-pulse 2.5s ease-in-out infinite;
}

/* 道号输入 */
.name-input-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 0 48rpx 36rpx;
  width: 100%;
  box-sizing: border-box;
  animation: fade-in 0.6s ease-out;
}

.name-input-label {
  font-size: 26rpx;
  color: var(--text-mist);
  letter-spacing: 6rpx;
}

.name-input {
  background: rgba(255, 255, 255, 0.92);
  color: var(--gold-leaf);
  border: 1rpx solid var(--border-ink-light);
  border-radius: var(--radius-sm);
  font-size: 32rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  width: 70%;
  box-sizing: border-box;
  letter-spacing: 4rpx;
  padding: 0 28rpx;
  transition: border-color 0.3s;
}

.name-input:focus {
  border-color: var(--gold-dim);
}

/* ═══════════════════════════════════════════
   状态 1.5：命格签选择
   ═══════════════════════════════════════════ */
.destiny-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 28rpx;
  padding: 40rpx 28rpx 56rpx;
  box-sizing: border-box;
}

.destiny-panel-head {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  align-items: center;
  text-align: center;
}

.destiny-eyebrow {
  font-size: 22rpx;
  color: var(--text-mist-dim);
  letter-spacing: 8rpx;
}

.destiny-title {
  font-size: 40rpx;
  color: var(--gold-leaf);
  line-height: 1.35;
  letter-spacing: 0;
}

.destiny-subtitle {
  font-size: 24rpx;
  color: var(--text-mist);
  line-height: 1.6;
  padding: 0 28rpx;
}

.destiny-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.destiny-card {
  width: 100%;
  padding: 26rpx 24rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  border: 1rpx solid rgba(156, 139, 111, 0.28);
  background:
    linear-gradient(180deg, rgba(255, 252, 247, 0.96) 0%, rgba(245, 239, 229, 0.94) 100%);
  box-shadow: 0 12rpx 30rpx rgba(107, 92, 68, 0.08);
  text-align: left;
  position: relative;
  z-index: 1;
  transition: transform 0.12s ease, border-color 0.12s ease, box-shadow 0.12s ease;
}

.destiny-card:active {
  transform: scale(0.985);
  border-color: rgba(203, 162, 91, 0.48);
  box-shadow: 0 8rpx 22rpx rgba(107, 92, 68, 0.12);
}

.destiny-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.destiny-card-title {
  font-size: 32rpx;
  color: var(--ink-strong);
  font-weight: 700;
  letter-spacing: 2rpx;
}

.destiny-card-pick {
  font-size: 24rpx;
  color: var(--cinnabar);
  letter-spacing: 4rpx;
}

.destiny-card-summary {
  display: block;
  font-size: 24rpx;
  color: var(--text-mist);
  line-height: 1.7;
  letter-spacing: 1rpx;
}

.destiny-error {
  font-size: 24rpx;
  color: var(--cinnabar);
  text-align: center;
  line-height: 1.6;
}

.ambition-panel .destiny-card {
  position: relative;
  overflow: hidden;
}

.ambition-panel .destiny-card::before {
  content: '';
  position: absolute;
  top: 18rpx;
  right: -34rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle, rgba(176, 51, 38, 0.14), rgba(176, 51, 38, 0));
  pointer-events: none;
}

.ambition-reward {
  display: block;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(156, 139, 111, 0.2);
  font-size: 22rpx;
  color: var(--cinnabar);
  line-height: 1.6;
  letter-spacing: 1rpx;
}

.ambition-ribbon {
  margin: 0 26rpx 18rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(203, 162, 91, 0.36);
  border-radius: 8rpx;
  background:
    linear-gradient(135deg, rgba(34, 30, 24, 0.92), rgba(80, 42, 34, 0.88)),
    radial-gradient(circle at 100% 0%, rgba(203, 162, 91, 0.24), transparent 45%);
  box-shadow: 0 16rpx 34rpx rgba(28, 20, 12, 0.22);
}

.ambition-ribbon-label {
  display: block;
  font-size: 20rpx;
  color: rgba(233, 214, 168, 0.72);
  letter-spacing: 8rpx;
}

.ambition-ribbon-title {
  display: inline-block;
  margin-top: 8rpx;
  margin-right: 18rpx;
  font-size: 32rpx;
  color: var(--gold-leaf);
  font-weight: 700;
  letter-spacing: 3rpx;
}

.ambition-ribbon-progress {
  font-size: 22rpx;
  color: rgba(255, 252, 247, 0.82);
  letter-spacing: 1rpx;
}

.phase3k-panel {
  margin: 0 26rpx 16rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(156, 139, 111, 0.32);
  border-radius: 8rpx;
  background: rgba(255, 252, 247, 0.82);
  box-shadow: 0 10rpx 24rpx rgba(90, 78, 58, 0.08);
}

.phase3k-meta,
.run-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.phase3k-chip,
.run-stat {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 14rpx;
  border-radius: 6rpx;
  background: rgba(34, 30, 24, 0.08);
  color: var(--text-mist);
  font-size: 21rpx;
  letter-spacing: 1rpx;
}

.phase3k-chip.risk-medium {
  color: var(--gold-leaf);
  background: rgba(203, 162, 91, 0.12);
}

.phase3k-chip.risk-high {
  color: var(--cinnabar);
  background: rgba(176, 51, 38, 0.1);
}

.light-choice-card {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(156, 139, 111, 0.2);
}

.light-choice-label {
  display: block;
  font-size: 20rpx;
  color: var(--text-mist-dim);
  letter-spacing: 4rpx;
}

.light-choice-text {
  display: block;
  margin-top: 8rpx;
  color: var(--ink-strong);
  font-size: 24rpx;
  line-height: 1.55;
  letter-spacing: 0;
}

.run-stats {
  margin-top: 14rpx;
}

.run-map-panel {
  margin: 0 26rpx 12rpx;
  padding: 14rpx 16rpx 16rpx;
  border: 1rpx solid rgba(48, 58, 60, 0.22);
  border-radius: 8rpx;
  background:
    linear-gradient(180deg, rgba(255, 252, 247, 0.9), rgba(240, 235, 224, 0.86)),
    repeating-linear-gradient(0deg, rgba(34, 30, 24, 0.025), rgba(34, 30, 24, 0.025) 2rpx, transparent 2rpx, transparent 8rpx);
  box-shadow: 0 10rpx 26rpx rgba(90, 78, 58, 0.08);
}

.run-map-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 12rpx;
}

.run-map-eyebrow {
  display: block;
  font-size: 18rpx;
  color: var(--text-mist-dim);
  letter-spacing: 6rpx;
}

.run-map-title {
  display: block;
  margin-top: 4rpx;
  font-size: 28rpx;
  color: var(--ink-strong);
  font-weight: 700;
  letter-spacing: 2rpx;
}

.run-map-state {
  flex-shrink: 0;
  min-width: 116rpx;
  padding: 8rpx 10rpx;
  border-radius: 6rpx;
  background: rgba(203, 162, 91, 0.12);
  color: var(--gold-leaf);
  font-size: 20rpx;
  text-align: center;
  letter-spacing: 2rpx;
}

.run-map-notice {
  margin-bottom: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: 6rpx;
  border: 1rpx solid rgba(203, 162, 91, 0.26);
  background: rgba(203, 162, 91, 0.1);
  color: var(--text-mist);
  font-size: 22rpx;
  line-height: 1.55;
  letter-spacing: 1rpx;
}

.run-map-notice.notice-finale {
  border-color: rgba(176, 51, 38, 0.28);
  background: rgba(176, 51, 38, 0.08);
  color: var(--ink-strong);
}

.run-map-board {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.run-node {
  width: 31%;
  min-height: 88rpx;
  padding: 10rpx 8rpx;
  border: 1rpx solid rgba(156, 139, 111, 0.24);
  border-radius: 8rpx;
  background: rgba(255, 252, 247, 0.78);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 4rpx;
  text-align: center;
  opacity: 0.58;
}

.run-node-route,
.run-node-layer {
  font-size: 17rpx;
  color: var(--text-mist-dim);
  letter-spacing: 1rpx;
}

.run-node-label {
  font-size: 22rpx;
  color: var(--text-mist);
  font-weight: 700;
  letter-spacing: 2rpx;
}

.run-node.node-available {
  opacity: 1;
  border-color: rgba(203, 162, 91, 0.5);
  background: linear-gradient(180deg, rgba(255, 250, 238, 0.98), rgba(244, 232, 204, 0.92));
  box-shadow: 0 8rpx 18rpx rgba(126, 96, 42, 0.12);
}

.run-node.node-current {
  opacity: 1;
  border-color: rgba(176, 51, 38, 0.45);
  background: rgba(176, 51, 38, 0.08);
}

.run-node.node-visited {
  opacity: 0.86;
  border-color: rgba(76, 116, 96, 0.36);
  background: rgba(76, 116, 96, 0.08);
}

.run-node.risk-high .run-node-label {
  color: var(--cinnabar);
}

.run-node.risk-medium .run-node-label {
  color: var(--gold-leaf);
}

/* ═══════════════════════════════════════════
   M4：全局路线图 · 国风暗卷覆盖
   ═══════════════════════════════════════════ */
.ambition-ribbon {
  margin: 0 20rpx 12rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid rgba(210, 168, 88, 0.34);
  border-radius: 8rpx;
  background:
    linear-gradient(100deg, rgba(38, 30, 24, 0.96), rgba(84, 38, 30, 0.86)),
    radial-gradient(circle at 100% 0%, rgba(203, 162, 91, 0.24), transparent 45%);
  box-shadow: 0 14rpx 26rpx rgba(4, 6, 6, 0.28);
}

.ambition-ribbon-label {
  display: inline-block;
  margin-right: 14rpx;
  letter-spacing: 4rpx;
}

.ambition-ribbon-title {
  margin-top: 0;
  font-size: 30rpx;
  color: #e0bf70;
}

.phase3k-panel {
  margin: 0 20rpx 12rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(210, 168, 88, 0.24);
  border-radius: 8rpx;
  background: rgba(20, 25, 23, 0.82);
  box-shadow: 0 12rpx 28rpx rgba(4, 6, 6, 0.22);
}

.phase3k-title {
  display: block;
  margin-bottom: 10rpx;
  color: rgba(224, 191, 112, 0.86);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.phase3k-chip,
.run-stat {
  background: rgba(219, 198, 146, 0.08);
  color: rgba(225, 214, 190, 0.82);
  letter-spacing: 1rpx;
}

.light-choice-text {
  color: rgba(245, 233, 205, 0.92);
}

.run-map-panel {
  margin: 0 20rpx 12rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(210, 168, 88, 0.28);
  border-radius: 8rpx;
  background:
    radial-gradient(circle at 15% 12%, rgba(176, 51, 38, 0.18), transparent 28%),
    radial-gradient(circle at 86% 8%, rgba(210, 168, 88, 0.16), transparent 30%),
    linear-gradient(180deg, rgba(24, 29, 26, 0.96), rgba(13, 18, 16, 0.94)),
    repeating-linear-gradient(0deg, rgba(223, 196, 132, 0.026), rgba(223, 196, 132, 0.026) 2rpx, transparent 2rpx, transparent 8rpx);
  box-shadow: 0 16rpx 36rpx rgba(2, 4, 4, 0.38);
}

.run-map-eyebrow {
  color: rgba(224, 191, 112, 0.64);
  font-size: 20rpx;
  letter-spacing: 3rpx;
}

.run-map-title {
  color: #ecd6a1;
  font-size: 32rpx;
}

.run-map-state {
  background: rgba(203, 162, 91, 0.16);
  color: #e0bf70;
}

.run-map-notice {
  border-color: rgba(203, 162, 91, 0.24);
  background: rgba(203, 162, 91, 0.09);
  color: rgba(234, 222, 198, 0.86);
}

.run-map-notice.notice-finale {
  background: rgba(176, 51, 38, 0.12);
  color: #f0d9aa;
}

.realm-strip {
  display: flex;
  gap: 8rpx;
  margin-bottom: 14rpx;
}

.realm-step {
  flex: 1;
  min-width: 0;
  padding: 10rpx 6rpx;
  border: 1rpx solid rgba(208, 184, 128, 0.12);
  border-radius: 6rpx;
  background: rgba(9, 12, 12, 0.42);
  text-align: center;
}

.realm-step-name,
.realm-step-summary {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.realm-step-name {
  color: rgba(224, 214, 190, 0.58);
  font-size: 20rpx;
  letter-spacing: 0;
}

.realm-step-summary {
  margin-top: 2rpx;
  color: rgba(224, 214, 190, 0.36);
  font-size: 16rpx;
  letter-spacing: 0;
}

.realm-step.realm-current {
  border-color: rgba(224, 191, 112, 0.58);
  background: rgba(148, 96, 40, 0.18);
  box-shadow: 0 0 18rpx rgba(224, 191, 112, 0.14);
}

.realm-step.realm-current .realm-step-name {
  color: #e6c77c;
  font-weight: 700;
}

.realm-step.realm-passed {
  border-color: rgba(90, 174, 130, 0.22);
}

.realm-step.realm-passed .realm-step-name {
  color: rgba(126, 201, 160, 0.68);
}

.run-stage-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.run-stage {
  border: 1rpx solid rgba(208, 184, 128, 0.12);
  border-radius: 8rpx;
  background: rgba(7, 10, 10, 0.28);
  overflow: hidden;
}

.run-stage.stage-expanded {
  border-color: rgba(224, 191, 112, 0.32);
  background: rgba(13, 19, 17, 0.72);
}

.run-stage.stage-passed {
  border-color: rgba(90, 174, 130, 0.18);
}

.run-stage-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 10rpx 12rpx;
  border-bottom: 1rpx solid rgba(208, 184, 128, 0.1);
}

.run-stage-name {
  color: rgba(236, 214, 161, 0.88);
  font-size: 24rpx;
  font-weight: 700;
}

.run-stage-state {
  color: rgba(224, 214, 190, 0.52);
  font-size: 20rpx;
}

.run-map-board {
  padding: 10rpx;
}

.board-collapsed {
  flex-wrap: nowrap;
  opacity: 0.78;
  padding: 8rpx 10rpx 10rpx;
}

.stage-collapsed .run-node {
  flex: 1;
  width: auto;
  min-height: 18rpx;
  height: 18rpx;
  padding: 0;
  border-radius: 999rpx;
}

.stage-collapsed .run-node-route,
.stage-collapsed .run-node-label,
.stage-collapsed .run-node-layer {
  display: none;
}

.run-node {
  width: calc((100% - 20rpx) / 3);
  min-height: 92rpx;
  padding: 12rpx 8rpx;
  border-color: rgba(208, 184, 128, 0.16);
  background:
    linear-gradient(180deg, rgba(39, 39, 34, 0.84), rgba(17, 22, 20, 0.88));
  opacity: 0.42;
}

.run-node-route,
.run-node-layer {
  color: rgba(224, 214, 190, 0.38);
  letter-spacing: 0;
}

.run-node-label {
  color: rgba(232, 221, 196, 0.72);
  letter-spacing: 1rpx;
}

.run-node.node-available {
  border-color: rgba(224, 191, 112, 0.68);
  background:
    radial-gradient(circle at 50% 0%, rgba(224, 191, 112, 0.18), transparent 56%),
    linear-gradient(180deg, rgba(67, 50, 28, 0.96), rgba(28, 32, 27, 0.92));
  box-shadow: 0 0 22rpx rgba(224, 191, 112, 0.16);
}

.run-node.node-current {
  border-color: rgba(196, 67, 53, 0.64);
  background:
    radial-gradient(circle at 50% 0%, rgba(196, 67, 53, 0.22), transparent 58%),
    rgba(50, 24, 21, 0.72);
}

.run-node.node-visited {
  border-color: rgba(90, 174, 130, 0.34);
  background: rgba(36, 62, 50, 0.24);
}

.run-node.risk-high .run-node-label {
  color: #d96a5d;
}

.run-node.risk-medium .run-node-label {
  color: #e0bf70;
}

.epitaph-board {
  display: flex;
  justify-content: center;
  gap: 18rpx;
  margin: 12rpx 0 20rpx;
  font-size: 24rpx;
  color: var(--gold-leaf);
  letter-spacing: 2rpx;
}

.next-goal-hint {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(203, 162, 91, 0.28);
  background: rgba(34, 30, 24, 0.08);
  color: var(--text-mist);
  font-size: 24rpx;
  line-height: 1.7;
}

.karma-submit-panel {
  margin-top: 26rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(176, 51, 38, 0.24);
  background: rgba(38, 22, 18, 0.16);
}

.karma-textarea {
  width: 100%;
  min-height: 92rpx;
  margin-top: 12rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border-radius: 6rpx;
  background: rgba(255, 252, 247, 0.86);
  color: var(--ink-strong);
  font-size: 24rpx;
  line-height: 1.6;
}

.karma-effect-row {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.karma-effect {
  flex: 1;
  padding: 14rpx 6rpx;
  border-radius: 6rpx;
  border: 1rpx solid rgba(156, 139, 111, 0.32);
  background: rgba(34, 30, 24, 0.08);
  color: var(--text-mist);
  font-size: 22rpx;
}

.karma-effect::after {
  border: none;
}

.karma-effect.active {
  color: var(--cinnabar);
  border-color: rgba(176, 51, 38, 0.45);
  background: rgba(176, 51, 38, 0.1);
}

.karma-submit-btn {
  margin-top: 18rpx;
}

.karma-submit-status {
  display: block;
  margin-top: 12rpx;
  color: var(--gold-leaf);
  font-size: 22rpx;
  line-height: 1.5;
}

/* ═══════════════════════════════════════════
   状态 2：挂机中（IDLE）— 修炼日志
   ═══════════════════════════════════════════ */
.idle-content {
  display: flex;
  flex-direction: column;
  min-height: 0;
  background: transparent;
}

.idle-fixed {
  flex-shrink: 0;
  background: linear-gradient(180deg, rgba(10, 13, 12, 0.84), rgba(10, 13, 12, 0.12));
  border-bottom: 1rpx solid rgba(210, 168, 88, 0.12);
  padding-top: 14rpx;
}

.idle-scroll {
  flex: 1;
  min-height: 0;
  padding-top: 4rpx;
}

.log-container {
  margin: 0 20rpx 24rpx;
  padding: 6rpx 18rpx 14rpx;
  border: 1rpx solid rgba(210, 168, 88, 0.16);
  border-radius: 8rpx;
  background: rgba(8, 11, 11, 0.58);
  box-shadow: inset 0 0 28rpx rgba(210, 168, 88, 0.04);
}

.idle-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 22rpx 24rpx 8rpx;
}

.idle-loader {
  width: 236rpx;
  height: 236rpx;
}

.idle-title {
  font-size: 32rpx;
  color: var(--gold-leaf);
  letter-spacing: 6rpx;
}

.idle-subtitle {
  font-size: 22rpx;
  color: var(--text-mist-dim);
  letter-spacing: 2rpx;
  text-align: center;
  line-height: 1.6;
  padding: 0 56rpx;
}

.log-entry {
  padding: 12rpx 2rpx;
  border-bottom: 1rpx solid rgba(210, 168, 88, 0.1);
  font-size: 24rpx;
  color: rgba(226, 218, 198, 0.72);
  word-break: break-all;
  line-height: 1.65;
  letter-spacing: 0;
  animation: fade-in 0.35s ease-out;
}

.log-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 20rpx 8rpx;
  padding: 0 4rpx;
}

.log-title {
  color: #e0bf70;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.log-subtitle {
  color: rgba(224, 214, 190, 0.46);
  font-size: 20rpx;
  letter-spacing: 0;
}

.log-entry:last-child {
  border-bottom: none;
}

/* 日志中金/红高亮 */
.log-entry .highlight-gold {
  color: var(--gold-pale);
}

.log-entry .highlight-red {
  color: var(--cinnabar);
}

/* ═══════════════════════════════════════════
   状态 3：事件触发（AWAIT_DECISION）— 天道符诏
   ═══════════════════════════════════════════ */

/* 事件卡片 — 仿古卷轴 */
.event-card {
  margin: 20rpx 24rpx 8rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.97), rgba(247, 241, 232, 0.96));
  border: 1rpx solid rgba(200, 160, 80, 0.22);
  border-radius: var(--radius-md);
  padding: 28rpx 24rpx 24rpx;
  position: relative;
  animation: ink-reveal 0.6s ease-out;
  box-shadow: var(--shadow-card), var(--shadow-gold);
}

/* 卷轴四角装饰 */
.event-card::before {
  content: "◆";
  position: absolute;
  top: 10rpx;
  left: 16rpx;
  font-size: 14rpx;
  color: rgba(200, 160, 80, 0.25);
}

.event-card::after {
  content: "◆";
  position: absolute;
  top: 10rpx;
  right: 16rpx;
  font-size: 14rpx;
  color: rgba(200, 160, 80, 0.25);
}

.event-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.event-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--gold-leaf);
  letter-spacing: 4rpx;
}

/* 倒计时 — 朱砂色紧迫感 */
.event-countdown {
  font-size: 22rpx;
  color: var(--cinnabar-bright);
  padding: 6rpx 16rpx;
  border: 1rpx solid rgba(212, 61, 61, 0.4);
  border-radius: 4rpx;
  letter-spacing: 2rpx;
  font-weight: 600;
}

.event-countdown.urgent {
  animation: cinnabar-pulse 0.8s ease-in-out infinite;
}

.event-description {
  font-size: 28rpx;
  color: var(--text-parchment);
  line-height: 1.8;
  letter-spacing: 1rpx;
}

/* 底部双角 */
.event-footer-corners {
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  opacity: 0.2;
  font-size: 14rpx;
  color: var(--gold-pale);
}

/* 决策按钮区 */
.decision-area {
  padding: 8rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.decision-btn {
  width: 100%;
  animation: fade-in 0.5s ease-out;
}

/* 自由对线入口 — 特殊样式 */
.free-input-toggle {
  background: transparent;
  color: var(--text-mist);
  border: 1rpx dashed rgba(120, 130, 150, 0.35);
  border-radius: var(--radius-sm);
  padding: 18rpx 36rpx;
  font-size: 28rpx;
  text-align: center;
  letter-spacing: 2rpx;
  animation: fade-in 0.55s ease-out;
}

.free-input-toggle:active {
  border-color: var(--gold-dim);
  color: var(--gold-pale);
}

/* 自定义输入区 */
.custom-input-area {
  margin: 16rpx 24rpx;
  animation: fade-in 0.35s ease-out;
}

.custom-textarea {
  background: rgba(255, 255, 255, 0.94);
  color: var(--text-parchment);
  border: 1rpx solid var(--border-ink-light);
  border-radius: var(--radius-sm);
  padding: 18rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 120rpx;
  letter-spacing: 1rpx;
  line-height: 1.6;
}

.custom-textarea:focus {
  border-color: var(--gold-dim);
}

.custom-input-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.custom-input-btns button {
  flex: 1;
}

/* ═══════════════════════════════════════════
   状态 4：流式故事（STREAMING）— 天道宣纸
   ═══════════════════════════════════════════ */
.story-scroll {
  flex: 1;
  padding: 20rpx 24rpx !important;
}

.stream-shell {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.stream-eyebrow {
  font-size: 22rpx;
  color: var(--text-mist-dim);
  letter-spacing: 6rpx;
  text-align: center;
}

.stream-title-card,
.stream-verdict-card {
  background: linear-gradient(180deg, rgba(255, 252, 247, 0.96), rgba(245, 239, 229, 0.92));
  border: 1rpx solid rgba(200, 160, 80, 0.24);
  border-radius: 12rpx;
  padding: 20rpx 22rpx;
  box-shadow: 0 10rpx 24rpx rgba(120, 105, 80, 0.08);
}

.stream-title-card {
  text-align: center;
}

.stream-title-text {
  font-size: 34rpx;
  color: var(--gold-leaf);
  font-weight: 700;
  letter-spacing: 4rpx;
}

.story-area {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(247, 241, 232, 0.96));
  border: 1rpx solid rgba(200, 160, 80, 0.2);
  border-radius: var(--radius-sm);
  padding: 28rpx 24rpx;
  min-height: 120rpx;
  position: relative;
  /* 宣纸纹理 */
  box-shadow:
    inset 0 0 60rpx rgba(164, 148, 122, 0.08),
    0 0 30rpx rgba(200, 160, 80, 0.06);
}

/* 竖排暗纹仿古卷 */
.story-area::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  background:
    repeating-linear-gradient(
      0deg,
      transparent,
      transparent 4rpx,
      rgba(200, 160, 80, 0.015) 4rpx,
      rgba(200, 160, 80, 0.015) 6rpx
    );
  border-radius: var(--radius-sm);
}

.story-section-label {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  margin-bottom: 14rpx;
  font-size: 20rpx;
  color: var(--text-mist-dim);
  letter-spacing: 6rpx;
}

.verdict-label {
  margin-bottom: 10rpx;
}

.story-text {
  font-size: 30rpx;
  color: var(--text-parchment);
  line-height: 2;
  word-break: break-all;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 1;
}

/* 天道编故事提示 */
.streaming-hint {
  text-align: center;
  padding: 18rpx;
  color: var(--text-mist-dim);
  font-size: 24rpx;
  letter-spacing: 4rpx;
}

.streaming-hint text {
  animation: qi-pulse 2.5s ease-in-out infinite;
}

.stream-verdict-text {
  font-size: 30rpx;
  line-height: 1.75;
  color: var(--gold-leaf);
  font-weight: 700;
  text-align: center;
}

/* ═══════════════════════════════════════════
   状态 5：结算（SETTLEMENT）— 天道裁决
   ═══════════════════════════════════════════ */
.settlement-panel {
  margin: 24rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(247, 241, 232, 0.97));
  border: 1rpx solid rgba(200, 160, 80, 0.24);
  border-radius: var(--radius-lg);
  padding: 32rpx 24rpx;
  position: relative;
  animation: ink-reveal 0.7s ease-out;
  box-shadow: var(--shadow-card), var(--shadow-gold);
}

/* 顶部金线装饰 */
.settlement-panel::before {
  content: "";
  position: absolute;
  top: 0;
  left: 20rpx;
  right: 20rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--gold-dim) 30%, var(--gold-leaf) 50%, var(--gold-dim) 70%, transparent);
}

/* 底部金线装饰 */
.settlement-panel::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 20rpx;
  right: 20rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--gold-dim) 30%, var(--gold-leaf) 50%, var(--gold-dim) 70%, transparent);
}

.settlement-header {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--gold-leaf);
  margin-bottom: 20rpx;
  text-align: center;
  letter-spacing: 6rpx;
}

.settlement-title {
  margin-bottom: 18rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--ink-strong);
  font-weight: 700;
  letter-spacing: 4rpx;
}

.settlement-body {
  font-size: 28rpx;
  color: var(--text-parchment);
  line-height: 1.9;
  letter-spacing: 1rpx;
  text-align: justify;
}

.settlement-reason {
  font-size: 28rpx;
  color: var(--text-parchment);
  line-height: 1.9;
  letter-spacing: 1rpx;
  text-align: justify;
}

.settlement-verdict {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(200, 160, 80, 0.28);
  border-radius: 12rpx;
  background: rgba(248, 243, 234, 0.92);
  font-size: 30rpx;
  line-height: 1.7;
  color: var(--gold-leaf);
  font-weight: 700;
  text-align: center;
}

.settlement-return {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 24rpx;
  color: var(--text-mist);
  letter-spacing: 2rpx;
}

.settlement-points {
  margin-top: 20rpx;
  padding-top: 16rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--gold-bright);
  text-align: center;
  letter-spacing: 4rpx;
}

/* ═══════════════════════════════════════════
   状态 6：游戏结束（GAME_OVER）— 道陨
   ═══════════════════════════════════════════ */
.game-over-panel {
  border-color: rgba(212, 61, 61, 0.4) !important;
  box-shadow: var(--shadow-card), 0 0 36rpx rgba(180, 40, 40, 0.12) !important;
  animation: ink-reveal 0.8s ease-out, tremor 0.5s ease-in-out 0.8s !important;
}

.game-over-panel::before {
  background: linear-gradient(90deg, transparent, var(--cinnabar-dark), var(--cinnabar), var(--cinnabar-dark), transparent) !important;
}

.game-over-panel::after {
  background: linear-gradient(90deg, transparent, var(--cinnabar-dark), var(--cinnabar), var(--cinnabar-dark), transparent) !important;
}

.game-over-icon {
  font-size: 72rpx;
  text-align: center;
  margin-bottom: 8rpx;
  filter: grayscale(30%);
}

.game-over-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--cinnabar-bright);
  text-align: center;
  margin-bottom: 18rpx;
  letter-spacing: 8rpx;
}

/* 再来一局 */
.new-game-btn {
  margin: 24rpx;
  animation: fade-in 0.6s ease-out 0.4s both;
}

/* ═══════════════════════════════════════════
   M3：因果遮蔽卡全屏反转
   ═══════════════════════════════════════════ */
.shield-rescue-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 200;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  background:
    radial-gradient(circle at 50% 45%, rgba(232, 196, 90, 0.3) 0%, rgba(245, 238, 219, 0.72) 34%, rgba(255, 252, 247, 0.94) 76%),
    rgba(255, 251, 244, 0.92);
  animation: shield-flash 2.6s ease-out both;
}

.shield-ring {
  position: absolute;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(232, 196, 90, 0.36);
  box-shadow: 0 0 60rpx rgba(232, 196, 90, 0.18);
}

.ring-a {
  animation: shield-ring-spin 2.2s linear infinite;
}

.ring-b {
  width: 560rpx;
  height: 560rpx;
  border-color: rgba(200, 160, 80, 0.18);
  animation: shield-ring-spin 3.2s linear reverse infinite;
}

.shield-seal {
  width: 132rpx;
  height: 132rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #0d0d14;
  background: linear-gradient(160deg, #7a5a20, #e8c45a 52%, #8b6d38);
  border-radius: 50%;
  font-size: 72rpx;
  font-weight: 800;
  position: relative;
  z-index: 1;
  box-shadow: 0 0 72rpx rgba(232, 196, 90, 0.42);
}

.shield-title {
  color: var(--gold-bright);
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 12rpx;
  position: relative;
  z-index: 1;
}

.shield-text {
  color: var(--text-parchment);
  font-size: 28rpx;
  letter-spacing: 3rpx;
  text-align: center;
  padding: 0 64rpx;
  position: relative;
  z-index: 1;
}

@keyframes sin-flame {
  0%, 100% { transform: translateY(0) scale(0.9); opacity: 0.55; }
  50% { transform: translateY(-6rpx) scale(1.2); opacity: 1; }
}

@keyframes ember-rise {
  0% { transform: translateY(8rpx) scale(0.6); opacity: 0; }
  35% { opacity: 0.85; }
  100% { transform: translateY(-28rpx) scale(0.2); opacity: 0; }
}

@keyframes sin-track-tremor {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-2rpx); }
  50% { transform: translateX(2rpx); }
  75% { transform: translateX(-1rpx); }
}

@keyframes shield-flash {
  0% { opacity: 0; filter: brightness(2.8); transform: scale(1.04); }
  12% { opacity: 1; filter: brightness(1.9); }
  72% { opacity: 1; filter: brightness(1); }
  100% { opacity: 0; filter: brightness(1); transform: scale(1); }
}

@keyframes shield-ring-spin {
  from { transform: rotate(0deg) scale(0.92); }
  to { transform: rotate(360deg) scale(1.06); }
}

@keyframes aura-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
