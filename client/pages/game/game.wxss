/**
 * 挂机修炼页面 — 水墨宇宙风格
 */

/* ═══════════════════════════════════════════
   页面容器
   ═══════════════════════════════════════════ */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background:
    radial-gradient(ellipse 72% 52% at 24% 86%, rgba(120, 110, 94, 0.12) 0%, transparent 62%),
    radial-gradient(ellipse 58% 36% at 82% 12%, rgba(170, 160, 144, 0.14) 0%, transparent 56%),
    linear-gradient(180deg, #fcfaf5 0%, #f4ede2 100%);
  position: relative;
}

/* 页面暗纹纹理 */
.page::after {
  content: "";
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
  background:
    repeating-linear-gradient(
      90deg,
      transparent,
      transparent 3rpx,
      rgba(128, 115, 94, 0.028) 3rpx,
      rgba(128, 115, 94, 0.028) 5rpx
    );
}

/* ═══════════════════════════════════════════
   状态栏 — 修仙六维面板
   ═══════════════════════════════════════════ */
.status-bar {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 16rpx 12rpx 14rpx;
  background: linear-gradient(180deg, rgba(255, 252, 247, 0.98) 0%, rgba(244, 237, 226, 0.98) 100%);
  border-bottom: 1rpx solid var(--border-ink-light);  
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.status-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
  width: 100%;
}

/* 底边金线灵气 */
.status-bar::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 10%;
  width: 80%;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(200, 160, 80, 0.2), rgba(200, 160, 80, 0.5), rgba(200, 160, 80, 0.2), transparent);
}

.status-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 100rpx;
  padding: 6rpx 8rpx;
  position: relative;
}

.status-label {
  font-size: 18rpx;
  color: var(--text-mist-dim);
  letter-spacing: 3rpx;
  text-transform: uppercase;
}

.status-value {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--gold-pale);
  letter-spacing: 1rpx;
}

/* 天谴值 — 朱砂色 */
.status-sin {
  color: var(--cinnabar) !important;
}

/* 天谴满值时脉动警告 */
.status-sin.danger {
  animation: cinnabar-pulse 1.2s ease-in-out infinite;
}

/* M3：天谴进度条 — 朱砂火脉 */
.sin-gauge {
  width: 100%;
  padding: 0 14rpx 4rpx;
  box-sizing: border-box;
  position: relative;
}

.sin-gauge-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.sin-gauge-label {
  font-size: 20rpx;
  color: var(--text-mist-dim);
  letter-spacing: 5rpx;
}

.sin-gauge-value {
  font-size: 22rpx;
  color: var(--cinnabar);
  font-weight: 700;
  letter-spacing: 2rpx;
}

.sin-track {
  height: 16rpx;
  border: 1rpx solid rgba(122, 24, 24, 0.45);
  border-radius: 4rpx;
  background:
    linear-gradient(90deg, rgba(238, 228, 215, 0.96), rgba(245, 239, 229, 0.98)),
    #f2eadf;
  overflow: hidden;
  position: relative;
  box-shadow: inset 0 0 12rpx rgba(128, 112, 88, 0.14);
}

.sin-fill {
  height: 100%;
  min-width: 2rpx;
  background: linear-gradient(90deg, var(--cinnabar-dark), var(--cinnabar), var(--cinnabar-bright));
  border-radius: 3rpx;
  box-shadow: 0 0 18rpx rgba(212, 61, 61, 0.38);
  transition: width 0.45s ease-out;
  position: relative;
}

.sin-fill::after {
  content: "";
  position: absolute;
  right: -6rpx;
  top: -8rpx;
  width: 20rpx;
  height: 30rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(240, 74, 74, 0.65), transparent 70%);
  animation: sin-flame 0.9s ease-in-out infinite;
}

.sin-ember {
  position: absolute;
  bottom: -6rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: rgba(240, 74, 74, 0.8);
  opacity: 0;
}

.ember-a { left: 24%; animation: ember-rise 1.9s ease-in-out infinite; }
.ember-b { left: 56%; animation: ember-rise 2.4s ease-in-out 0.3s infinite; }
.ember-c { left: 82%; animation: ember-rise 1.6s ease-in-out 0.7s infinite; }

.sin-gauge.warning .sin-track {
  border-color: rgba(200, 160, 80, 0.45);
}

.sin-gauge.danger .sin-track {
  animation: sin-track-tremor 0.7s ease-in-out infinite;
  border-color: rgba(240, 74, 74, 0.75);
  box-shadow:
    inset 0 0 12rpx rgba(128, 112, 88, 0.14),
    0 0 24rpx rgba(212, 61, 61, 0.24);
}

/* ═══════════════════════════════════════════
   内容区
   ═══════════════════════════════════════════ */
.content-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
  z-index: 1;
}

.center-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 36rpx;
  position: relative;
  z-index: 1;
}

/* ═══════════════════════════════════════════
   状态 1：连接中
   ═══════════════════════════════════════════ */

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.meditation-loader {
  width: 280rpx;
  height: 280rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.meditation-aura {
  position: absolute;
  border-radius: 50%;
  border-style: solid;
  border-color: rgba(120, 110, 94, 0.18);
  opacity: 0.95;
}

.aura-outer {
  width: 238rpx;
  height: 238rpx;
  border-width: 2rpx;
  animation: aura-spin 6.5s linear infinite;
}

.aura-inner {
  width: 182rpx;
  height: 182rpx;
  border-width: 1rpx;
  border-top-color: rgba(201, 160, 80, 0.6);
  border-bottom-color: rgba(201, 160, 80, 0.26);
  animation: aura-spin 3.8s linear reverse infinite;
}

.cultivator {
  width: 170rpx;
  height: 170rpx;
  position: relative;
  filter: drop-shadow(0 12rpx 24rpx rgba(110, 102, 89, 0.12));
}

.cultivator-head {
  position: absolute;
  top: 26rpx;
  left: 66rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, rgba(88, 88, 92, 0.92), rgba(43, 43, 49, 0.96));
  box-shadow: inset 0 -4rpx 0 rgba(255, 255, 255, 0.08);
}

.cultivator-body {
  position: absolute;
  top: 62rpx;
  left: 52rpx;
  width: 66rpx;
  height: 52rpx;
  background: linear-gradient(180deg, rgba(72, 76, 82, 0.94), rgba(112, 118, 124, 0.88));
  border-radius: 42rpx 42rpx 26rpx 26rpx;
}

.cultivator-arm,
.cultivator-leg {
  position: absolute;
  background: linear-gradient(180deg, rgba(92, 96, 102, 0.9), rgba(58, 60, 66, 0.94));
}

.cultivator-arm {
  top: 86rpx;
  width: 46rpx;
  height: 14rpx;
  border-radius: 20rpx;
}

.arm-left {
  left: 30rpx;
  transform: rotate(18deg);
}

.arm-right {
  right: 30rpx;
  transform: rotate(-18deg);
}

.cultivator-leg {
  top: 114rpx;
  width: 60rpx;
  height: 24rpx;
  border-radius: 24rpx;
}

.leg-left {
  left: 26rpx;
  transform: rotate(18deg);
}

.leg-right {
  right: 26rpx;
  transform: rotate(-18deg);
}

.cultivator-cushion {
  position: absolute;
  bottom: 20rpx;
  left: 24rpx;
  width: 122rpx;
  height: 24rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 40%, rgba(240, 235, 224, 0.95), rgba(199, 184, 160, 0.92) 68%, rgba(160, 146, 123, 0.9));
  box-shadow:
    0 8rpx 18rpx rgba(132, 118, 95, 0.16),
    inset 0 2rpx 8rpx rgba(255, 255, 255, 0.32);
}

.loading-text {
  font-size: 32rpx;
  color: var(--text-mist);
  letter-spacing: 4rpx;
  animation: qi-pulse 2.5s ease-in-out infinite;
}

/* 道号输入 */
.name-input-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 0 48rpx 36rpx;
  width: 100%;
  box-sizing: border-box;
  animation: fade-in 0.6s ease-out;
}

.name-input-label {
  font-size: 26rpx;
  color: var(--text-mist);
  letter-spacing: 6rpx;
}

.name-input {
  background: rgba(255, 255, 255, 0.92);
  color: var(--gold-leaf);
  border: 1rpx solid var(--border-ink-light);
  border-radius: var(--radius-sm);
  font-size: 32rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  width: 70%;
  box-sizing: border-box;
  letter-spacing: 4rpx;
  padding: 0 28rpx;
  transition: border-color 0.3s;
}

.name-input:focus {
  border-color: var(--gold-dim);
}

/* ═══════════════════════════════════════════
   状态 1.5：命格签选择
   ═══════════════════════════════════════════ */
.destiny-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 28rpx;
  padding: 40rpx 28rpx 56rpx;
  box-sizing: border-box;
}

.destiny-panel-head {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  align-items: center;
  text-align: center;
}

.destiny-eyebrow {
  font-size: 22rpx;
  color: var(--text-mist-dim);
  letter-spacing: 8rpx;
}

.destiny-title {
  font-size: 40rpx;
  color: var(--gold-leaf);
  line-height: 1.35;
  letter-spacing: 0;
}

.destiny-subtitle {
  font-size: 24rpx;
  color: var(--text-mist);
  line-height: 1.6;
  padding: 0 28rpx;
}

.destiny-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.destiny-card {
  width: 100%;
  padding: 26rpx 24rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  border: 1rpx solid rgba(156, 139, 111, 0.28);
  background:
    linear-gradient(180deg, rgba(255, 252, 247, 0.96) 0%, rgba(245, 239, 229, 0.94) 100%);
  box-shadow: 0 12rpx 30rpx rgba(107, 92, 68, 0.08);
  text-align: left;
  position: relative;
  z-index: 1;
  transition: transform 0.12s ease, border-color 0.12s ease, box-shadow 0.12s ease;
}

.destiny-card:active {
  transform: scale(0.985);
  border-color: rgba(203, 162, 91, 0.48);
  box-shadow: 0 8rpx 22rpx rgba(107, 92, 68, 0.12);
}

.destiny-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.destiny-card-title {
  font-size: 32rpx;
  color: var(--ink-strong);
  font-weight: 700;
  letter-spacing: 2rpx;
}

.destiny-card-pick {
  font-size: 24rpx;
  color: var(--cinnabar);
  letter-spacing: 4rpx;
}

.destiny-card-summary {
  display: block;
  font-size: 24rpx;
  color: var(--text-mist);
  line-height: 1.7;
  letter-spacing: 1rpx;
}

.destiny-error {
  font-size: 24rpx;
  color: var(--cinnabar);
  text-align: center;
  line-height: 1.6;
}

.ambition-panel .destiny-card {
  position: relative;
  overflow: hidden;
}

.ambition-panel .destiny-card::before {
  content: '';
  position: absolute;
  top: 18rpx;
  right: -34rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle, rgba(176, 51, 38, 0.14), rgba(176, 51, 38, 0));
  pointer-events: none;
}

.ambition-reward {
  display: block;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(156, 139, 111, 0.2);
  font-size: 22rpx;
  color: var(--cinnabar);
  line-height: 1.6;
  letter-spacing: 1rpx;
}

.ambition-ribbon {
  margin: 0 26rpx 18rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(203, 162, 91, 0.36);
  border-radius: 8rpx;
  background:
    linear-gradient(135deg, rgba(34, 30, 24, 0.92), rgba(80, 42, 34, 0.88)),
    radial-gradient(circle at 100% 0%, rgba(203, 162, 91, 0.24), transparent 45%);
  box-shadow: 0 16rpx 34rpx rgba(28, 20, 12, 0.22);
}

.ambition-ribbon-label {
  display: block;
  font-size: 20rpx;
  color: rgba(233, 214, 168, 0.72);
  letter-spacing: 8rpx;
}

.ambition-ribbon-title {
  display: inline-block;
  margin-top: 8rpx;
  margin-right: 18rpx;
  font-size: 32rpx;
  color: var(--gold-leaf);
  font-weight: 700;
  letter-spacing: 3rpx;
}

.ambition-ribbon-progress {
  font-size: 22rpx;
  color: rgba(255, 252, 247, 0.82);
  letter-spacing: 1rpx;
}

.epitaph-board {
  display: flex;
  justify-content: center;
  gap: 18rpx;
  margin: 12rpx 0 20rpx;
  font-size: 24rpx;
  color: var(--gold-leaf);
  letter-spacing: 2rpx;
}

.next-goal-hint {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(203, 162, 91, 0.28);
  background: rgba(34, 30, 24, 0.08);
  color: var(--text-mist);
  font-size: 24rpx;
  line-height: 1.7;
}

.karma-submit-panel {
  margin-top: 26rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(176, 51, 38, 0.24);
  background: rgba(38, 22, 18, 0.16);
}

.karma-textarea {
  width: 100%;
  min-height: 92rpx;
  margin-top: 12rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border-radius: 6rpx;
  background: rgba(255, 252, 247, 0.86);
  color: var(--ink-strong);
  font-size: 24rpx;
  line-height: 1.6;
}

.karma-effect-row {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.karma-effect {
  flex: 1;
  padding: 14rpx 6rpx;
  border-radius: 6rpx;
  border: 1rpx solid rgba(156, 139, 111, 0.32);
  background: rgba(34, 30, 24, 0.08);
  color: var(--text-mist);
  font-size: 22rpx;
}

.karma-effect::after {
  border: none;
}

.karma-effect.active {
  color: var(--cinnabar);
  border-color: rgba(176, 51, 38, 0.45);
  background: rgba(176, 51, 38, 0.1);
}

.karma-submit-btn {
  margin-top: 18rpx;
}

.karma-submit-status {
  display: block;
  margin-top: 12rpx;
  color: var(--gold-leaf);
  font-size: 22rpx;
  line-height: 1.5;
}

/* ═══════════════════════════════════════════
   状态 2：挂机中（IDLE）— 修炼日志
   ═══════════════════════════════════════════ */
.log-container {
  flex: 1;
  padding: 12rpx 24rpx 20rpx;
  overflow-y: auto;
}

.idle-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 22rpx 24rpx 8rpx;
}

.idle-loader {
  width: 236rpx;
  height: 236rpx;
}

.idle-title {
  font-size: 32rpx;
  color: var(--gold-leaf);
  letter-spacing: 6rpx;
}

.idle-subtitle {
  font-size: 22rpx;
  color: var(--text-mist-dim);
  letter-spacing: 2rpx;
  text-align: center;
  line-height: 1.6;
  padding: 0 56rpx;
}

.log-entry {
  padding: 14rpx 4rpx;
  border-bottom: 1rpx solid rgba(181, 169, 154, 0.55);
  font-size: 26rpx;
  color: var(--text-mist);
  word-break: break-all;
  line-height: 1.65;
  letter-spacing: 1rpx;
  animation: fade-in 0.35s ease-out;
}

.log-entry:last-child {
  border-bottom: none;
}

/* 日志中金/红高亮 */
.log-entry .highlight-gold {
  color: var(--gold-pale);
}

.log-entry .highlight-red {
  color: var(--cinnabar);
}

/* ═══════════════════════════════════════════
   状态 3：事件触发（AWAIT_DECISION）— 天道符诏
   ═══════════════════════════════════════════ */

/* 事件卡片 — 仿古卷轴 */
.event-card {
  margin: 20rpx 24rpx 8rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.97), rgba(247, 241, 232, 0.96));
  border: 1rpx solid rgba(200, 160, 80, 0.22);
  border-radius: var(--radius-md);
  padding: 28rpx 24rpx 24rpx;
  position: relative;
  animation: ink-reveal 0.6s ease-out;
  box-shadow: var(--shadow-card), var(--shadow-gold);
}

/* 卷轴四角装饰 */
.event-card::before {
  content: "◆";
  position: absolute;
  top: 10rpx;
  left: 16rpx;
  font-size: 14rpx;
  color: rgba(200, 160, 80, 0.25);
}

.event-card::after {
  content: "◆";
  position: absolute;
  top: 10rpx;
  right: 16rpx;
  font-size: 14rpx;
  color: rgba(200, 160, 80, 0.25);
}

.event-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.event-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--gold-leaf);
  letter-spacing: 4rpx;
}

/* 倒计时 — 朱砂色紧迫感 */
.event-countdown {
  font-size: 22rpx;
  color: var(--cinnabar-bright);
  padding: 6rpx 16rpx;
  border: 1rpx solid rgba(212, 61, 61, 0.4);
  border-radius: 4rpx;
  letter-spacing: 2rpx;
  font-weight: 600;
}

.event-countdown.urgent {
  animation: cinnabar-pulse 0.8s ease-in-out infinite;
}

.event-description {
  font-size: 28rpx;
  color: var(--text-parchment);
  line-height: 1.8;
  letter-spacing: 1rpx;
}

/* 底部双角 */
.event-footer-corners {
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  opacity: 0.2;
  font-size: 14rpx;
  color: var(--gold-pale);
}

/* 决策按钮区 */
.decision-area {
  padding: 8rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.decision-btn {
  width: 100%;
  animation: fade-in 0.5s ease-out;
}

/* 自由对线入口 — 特殊样式 */
.free-input-toggle {
  background: transparent;
  color: var(--text-mist);
  border: 1rpx dashed rgba(120, 130, 150, 0.35);
  border-radius: var(--radius-sm);
  padding: 18rpx 36rpx;
  font-size: 28rpx;
  text-align: center;
  letter-spacing: 2rpx;
  animation: fade-in 0.55s ease-out;
}

.free-input-toggle:active {
  border-color: var(--gold-dim);
  color: var(--gold-pale);
}

/* 自定义输入区 */
.custom-input-area {
  margin: 16rpx 24rpx;
  animation: fade-in 0.35s ease-out;
}

.custom-textarea {
  background: rgba(255, 255, 255, 0.94);
  color: var(--text-parchment);
  border: 1rpx solid var(--border-ink-light);
  border-radius: var(--radius-sm);
  padding: 18rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 120rpx;
  letter-spacing: 1rpx;
  line-height: 1.6;
}

.custom-textarea:focus {
  border-color: var(--gold-dim);
}

.custom-input-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.custom-input-btns button {
  flex: 1;
}

/* ═══════════════════════════════════════════
   状态 4：流式故事（STREAMING）— 天道宣纸
   ═══════════════════════════════════════════ */
.story-scroll {
  flex: 1;
  padding: 20rpx 24rpx !important;
}

.stream-shell {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.stream-eyebrow {
  font-size: 22rpx;
  color: var(--text-mist-dim);
  letter-spacing: 6rpx;
  text-align: center;
}

.stream-title-card,
.stream-verdict-card {
  background: linear-gradient(180deg, rgba(255, 252, 247, 0.96), rgba(245, 239, 229, 0.92));
  border: 1rpx solid rgba(200, 160, 80, 0.24);
  border-radius: 12rpx;
  padding: 20rpx 22rpx;
  box-shadow: 0 10rpx 24rpx rgba(120, 105, 80, 0.08);
}

.stream-title-card {
  text-align: center;
}

.stream-title-text {
  font-size: 34rpx;
  color: var(--gold-leaf);
  font-weight: 700;
  letter-spacing: 4rpx;
}

.story-area {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(247, 241, 232, 0.96));
  border: 1rpx solid rgba(200, 160, 80, 0.2);
  border-radius: var(--radius-sm);
  padding: 28rpx 24rpx;
  min-height: 120rpx;
  position: relative;
  /* 宣纸纹理 */
  box-shadow:
    inset 0 0 60rpx rgba(164, 148, 122, 0.08),
    0 0 30rpx rgba(200, 160, 80, 0.06);
}

/* 竖排暗纹仿古卷 */
.story-area::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  background:
    repeating-linear-gradient(
      0deg,
      transparent,
      transparent 4rpx,
      rgba(200, 160, 80, 0.015) 4rpx,
      rgba(200, 160, 80, 0.015) 6rpx
    );
  border-radius: var(--radius-sm);
}

.story-section-label {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  margin-bottom: 14rpx;
  font-size: 20rpx;
  color: var(--text-mist-dim);
  letter-spacing: 6rpx;
}

.verdict-label {
  margin-bottom: 10rpx;
}

.story-text {
  font-size: 30rpx;
  color: var(--text-parchment);
  line-height: 2;
  word-break: break-all;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 1;
}

/* 天道编故事提示 */
.streaming-hint {
  text-align: center;
  padding: 18rpx;
  color: var(--text-mist-dim);
  font-size: 24rpx;
  letter-spacing: 4rpx;
}

.streaming-hint text {
  animation: qi-pulse 2.5s ease-in-out infinite;
}

.stream-verdict-text {
  font-size: 30rpx;
  line-height: 1.75;
  color: var(--gold-leaf);
  font-weight: 700;
  text-align: center;
}

/* ═══════════════════════════════════════════
   状态 5：结算（SETTLEMENT）— 天道裁决
   ═══════════════════════════════════════════ */
.settlement-panel {
  margin: 24rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(247, 241, 232, 0.97));
  border: 1rpx solid rgba(200, 160, 80, 0.24);
  border-radius: var(--radius-lg);
  padding: 32rpx 24rpx;
  position: relative;
  animation: ink-reveal 0.7s ease-out;
  box-shadow: var(--shadow-card), var(--shadow-gold);
}

/* 顶部金线装饰 */
.settlement-panel::before {
  content: "";
  position: absolute;
  top: 0;
  left: 20rpx;
  right: 20rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--gold-dim) 30%, var(--gold-leaf) 50%, var(--gold-dim) 70%, transparent);
}

/* 底部金线装饰 */
.settlement-panel::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 20rpx;
  right: 20rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--gold-dim) 30%, var(--gold-leaf) 50%, var(--gold-dim) 70%, transparent);
}

.settlement-header {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--gold-leaf);
  margin-bottom: 20rpx;
  text-align: center;
  letter-spacing: 6rpx;
}

.settlement-title {
  margin-bottom: 18rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--ink-strong);
  font-weight: 700;
  letter-spacing: 4rpx;
}

.settlement-body {
  font-size: 28rpx;
  color: var(--text-parchment);
  line-height: 1.9;
  letter-spacing: 1rpx;
  text-align: justify;
}

.settlement-reason {
  font-size: 28rpx;
  color: var(--text-parchment);
  line-height: 1.9;
  letter-spacing: 1rpx;
  text-align: justify;
}

.settlement-verdict {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(200, 160, 80, 0.28);
  border-radius: 12rpx;
  background: rgba(248, 243, 234, 0.92);
  font-size: 30rpx;
  line-height: 1.7;
  color: var(--gold-leaf);
  font-weight: 700;
  text-align: center;
}

.settlement-return {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 24rpx;
  color: var(--text-mist);
  letter-spacing: 2rpx;
}

.settlement-points {
  margin-top: 20rpx;
  padding-top: 16rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--gold-bright);
  text-align: center;
  letter-spacing: 4rpx;
}

/* ═══════════════════════════════════════════
   状态 6：游戏结束（GAME_OVER）— 道陨
   ═══════════════════════════════════════════ */
.game-over-panel {
  border-color: rgba(212, 61, 61, 0.4) !important;
  box-shadow: var(--shadow-card), 0 0 36rpx rgba(180, 40, 40, 0.12) !important;
  animation: ink-reveal 0.8s ease-out, tremor 0.5s ease-in-out 0.8s !important;
}

.game-over-panel::before {
  background: linear-gradient(90deg, transparent, var(--cinnabar-dark), var(--cinnabar), var(--cinnabar-dark), transparent) !important;
}

.game-over-panel::after {
  background: linear-gradient(90deg, transparent, var(--cinnabar-dark), var(--cinnabar), var(--cinnabar-dark), transparent) !important;
}

.game-over-icon {
  font-size: 72rpx;
  text-align: center;
  margin-bottom: 8rpx;
  filter: grayscale(30%);
}

.game-over-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--cinnabar-bright);
  text-align: center;
  margin-bottom: 18rpx;
  letter-spacing: 8rpx;
}

/* 再来一局 */
.new-game-btn {
  margin: 24rpx;
  animation: fade-in 0.6s ease-out 0.4s both;
}

/* ═══════════════════════════════════════════
   M3：因果遮蔽卡全屏反转
   ═══════════════════════════════════════════ */
.shield-rescue-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 200;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  background:
    radial-gradient(circle at 50% 45%, rgba(232, 196, 90, 0.3) 0%, rgba(245, 238, 219, 0.72) 34%, rgba(255, 252, 247, 0.94) 76%),
    rgba(255, 251, 244, 0.92);
  animation: shield-flash 2.6s ease-out both;
}

.shield-ring {
  position: absolute;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(232, 196, 90, 0.36);
  box-shadow: 0 0 60rpx rgba(232, 196, 90, 0.18);
}

.ring-a {
  animation: shield-ring-spin 2.2s linear infinite;
}

.ring-b {
  width: 560rpx;
  height: 560rpx;
  border-color: rgba(200, 160, 80, 0.18);
  animation: shield-ring-spin 3.2s linear reverse infinite;
}

.shield-seal {
  width: 132rpx;
  height: 132rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #0d0d14;
  background: linear-gradient(160deg, #7a5a20, #e8c45a 52%, #8b6d38);
  border-radius: 50%;
  font-size: 72rpx;
  font-weight: 800;
  position: relative;
  z-index: 1;
  box-shadow: 0 0 72rpx rgba(232, 196, 90, 0.42);
}

.shield-title {
  color: var(--gold-bright);
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 12rpx;
  position: relative;
  z-index: 1;
}

.shield-text {
  color: var(--text-parchment);
  font-size: 28rpx;
  letter-spacing: 3rpx;
  text-align: center;
  padding: 0 64rpx;
  position: relative;
  z-index: 1;
}

@keyframes sin-flame {
  0%, 100% { transform: translateY(0) scale(0.9); opacity: 0.55; }
  50% { transform: translateY(-6rpx) scale(1.2); opacity: 1; }
}

@keyframes ember-rise {
  0% { transform: translateY(8rpx) scale(0.6); opacity: 0; }
  35% { opacity: 0.85; }
  100% { transform: translateY(-28rpx) scale(0.2); opacity: 0; }
}

@keyframes sin-track-tremor {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-2rpx); }
  50% { transform: translateX(2rpx); }
  75% { transform: translateX(-1rpx); }
}

@keyframes shield-flash {
  0% { opacity: 0; filter: brightness(2.8); transform: scale(1.04); }
  12% { opacity: 1; filter: brightness(1.9); }
  72% { opacity: 1; filter: brightness(1); }
  100% { opacity: 0; filter: brightness(1); transform: scale(1); }
}

@keyframes shield-ring-spin {
  from { transform: rotate(0deg) scale(0.92); }
  to { transform: rotate(360deg) scale(1.06); }
}

@keyframes aura-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
