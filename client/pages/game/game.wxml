<view class="page">
  <view class="status-bar">
    <view class="status-grid">
      <view class="status-item">
        <text class="status-label">境 界</text>
        <text class="status-value">{{realm}}</text>
      </view>
      <view class="status-item">
        <text class="status-label">修 为</text>
        <text class="status-value">{{cultivation}}</text>
      </view>
      <view class="status-item">
        <text class="status-label">气 运</text>
        <text class="status-value">{{luck}}</text>
      </view>
      <view class="status-item">
        <text class="status-label">根 基</text>
        <text class="status-value">{{foundation}}</text>
      </view>
      <view class="status-item">
        <text class="status-label">天 道</text>
        <text class="status-value">{{sinPhase}}</text>
      </view>
    </view>

    <view class="sin-gauge {{sinPercent >= 80 ? 'danger' : sinPercent >= 50 ? 'warning' : ''}}">
      <view class="sin-gauge-head">
        <text class="sin-gauge-label">天 谴 值</text>
        <text class="sin-gauge-value">{{sinValue}} / {{sinMax}}</text>
      </view>
      <view class="sin-track">
        <view class="sin-fill" style="width: {{sinPercent}}%;"></view>
        <view class="sin-ember ember-a"></view>
        <view class="sin-ember ember-b"></view>
        <view class="sin-ember ember-c"></view>
      </view>
    </view>
  </view>

  <view wx:if="{{uiState === 'connecting'}}" class="center-area">
    <view class="loading">
      <view class="meditation-loader">
        <view class="meditation-aura aura-outer"></view>
        <view class="meditation-aura aura-inner"></view>
        <view class="cultivator cultivator-connecting">
          <view class="cultivator-head"></view>
          <view class="cultivator-body"></view>
          <view class="cultivator-arm arm-left"></view>
          <view class="cultivator-arm arm-right"></view>
          <view class="cultivator-leg leg-left"></view>
          <view class="cultivator-leg leg-right"></view>
          <view class="cultivator-cushion"></view>
        </view>
      </view>
      <text class="loading-text">等待天道连接</text>
    </view>
    <view class="name-input-area" wx:if="{{!gameOver}}">
      <text class="name-input-label">— 道 号 —</text>
      <input
        class="name-input"
        value="{{playerName}}"
        placeholder="赐名"
        maxlength="12"
        bindinput="onNameInput"
      />
    </view>
    <button wx:if="{{!gameOver}}" class="btn-gold" bindtap="onStartGame">踏 入 仙 途</button>
  </view>

  <view wx:if="{{uiState === 'preparing'}}" class="content-area">
    <view wx:if="{{ambitionOffers.length === 0}}" class="destiny-panel">
      <view class="destiny-panel-head">
        <text class="destiny-eyebrow">命 格 将 启</text>
        <text class="destiny-title">先定一口气，再去见天道</text>
        <text class="destiny-subtitle">本局仅生效一次，三选一后正式踏入仙途。</text>
      </view>

      <view class="destiny-list">
        <view
          wx:for="{{destinyOffers}}"
          wx:key="id"
          class="destiny-card"
          role="button"
          data-id="{{item.id}}"
          bindtap="onSelectDestiny"
        >
          <view class="destiny-card-top">
            <text class="destiny-card-title">{{item.title}}</text>
            <text class="destiny-card-pick">签</text>
          </view>
          <text class="destiny-card-summary">{{item.summary}}</text>
        </view>
      </view>

      <text wx:if="{{destinyError}}" class="destiny-error">{{destinyError}}</text>
    </view>

    <view wx:else class="destiny-panel ambition-panel">
      <view class="destiny-panel-head">
        <text class="destiny-eyebrow">执 念 落 笔</text>
        <text class="destiny-title">这一局，你想被怎样记住</text>
        <text class="destiny-subtitle">执念会成为本局目标。飞升是赢，死得漂亮也能留名。</text>
      </view>

      <view class="destiny-list">
        <view
          wx:for="{{ambitionOffers}}"
          wx:key="id"
          class="destiny-card ambition-card"
          role="button"
          data-id="{{item.id}}"
          bindtap="onSelectAmbition"
        >
          <view class="destiny-card-top">
            <text class="destiny-card-title">{{item.title}}</text>
            <text class="destiny-card-pick">念</text>
          </view>
          <text class="destiny-card-summary">{{item.summary}}</text>
          <text class="ambition-reward">{{item.reward_hint}}</text>
        </view>
      </view>

      <text wx:if="{{destinyError}}" class="destiny-error">{{destinyError}}</text>
    </view>
  </view>

  <view wx:if="{{uiState === 'idle'}}" class="content-area idle-content">
    <view class="idle-fixed">
      <view wx:if="{{ambitionTitle}}" class="ambition-ribbon">
        <text class="ambition-ribbon-label">本局执念</text>
        <text class="ambition-ribbon-title">{{ambitionTitle}}</text>
        <text wx:if="{{ambitionTarget > 0}}" class="ambition-ribbon-progress">
          {{ambitionProgressLabel}} {{ambitionProgress}} / {{ambitionTarget}}
        </text>
      </view>
      <view wx:if="{{hasRunMapNodes}}" class="run-map-panel">
        <view class="run-map-head">
          <view>
            <text class="run-map-eyebrow">M4 路 线</text>
            <text class="run-map-title">{{realm}} · 三路择命</text>
          </view>
          <text wx:if="{{hasRunMapChoice}}" class="run-map-state">择一节点</text>
          <text wx:elif="{{currentRunNodeId}}" class="run-map-state">行进中</text>
          <text wx:else class="run-map-state">待刷新</text>
        </view>
        <view wx:if="{{hasRouteNotice}}" class="run-map-notice notice-{{routeNoticeLevel}}">
          <text>{{routeNotice}}</text>
        </view>
        <view class="run-map-board">
          <view
            wx:for="{{runMapNodes}}"
            wx:key="node_id"
            class="run-node node-{{item.status}} risk-{{item.risk_level}}"
            data-id="{{item.node_id}}"
            data-status="{{item.status}}"
            bindtap="onChooseMapNode"
          >
            <text class="run-node-route">{{item.route_label}}</text>
            <text class="run-node-label">{{item.node_label}}</text>
            <text class="run-node-layer">第{{item.layer + 1}}步</text>
          </view>
        </view>
      </view>
    </view>
    <scroll-view class="idle-scroll" scroll-y scroll-into-view="log-end">
      <view wx:if="{{eventPool || showLightChoice || hasRunStats}}" class="phase3k-panel">
        <view class="phase3k-meta">
          <text wx:if="{{routeLabel}}" class="phase3k-chip">路 {{routeLabel}}</text>
          <text wx:if="{{routeNodeType}}" class="phase3k-chip">点 {{routeNodeType}}</text>
          <text wx:if="{{eventPool}}" class="phase3k-chip">池 {{eventPool}}</text>
          <text wx:if="{{riskLevel}}" class="phase3k-chip {{riskLevel === 'medium' ? 'risk-medium' : ''}} {{riskLevel === 'high' ? 'risk-high' : ''}}">险 {{riskLevel}}</text>
          <text wx:if="{{karmaTraceHook}}" class="phase3k-chip">因 {{karmaTraceHook}}</text>
        </view>
        <view wx:if="{{showLightChoice}}" class="light-choice-card">
          <text class="light-choice-label">轻选择自动结算</text>
          <text class="light-choice-text">{{lightChoiceText}}</text>
        </view>
        <view wx:if="{{hasRunStats}}" class="run-stats">
          <text wx:if="{{runStats.leaderboardScoreDelta > 0}}" class="run-stat">榜 +{{runStats.leaderboardScoreDelta}}</text>
          <text wx:if="{{runStats.tauntCount > 0}}" class="run-stat">嘴硬 {{runStats.tauntCount}}</text>
          <text wx:if="{{runStats.gambleSurviveCount > 0}}" class="run-stat">赌命 {{runStats.gambleSurviveCount}}</text>
          <text wx:if="{{runStats.karmaPollutionScore > 0}}" class="run-stat">污染 {{runStats.karmaPollutionScore}}</text>
          <text wx:if="{{runStats.deathDramaScore > 0}}" class="run-stat">死相 {{runStats.deathDramaScore}}</text>
        </view>
      </view>
      <view class="idle-hero">
        <view class="meditation-loader idle-loader">
          <view class="meditation-aura aura-outer"></view>
          <view class="meditation-aura aura-inner"></view>
          <view class="cultivator cultivator-idle">
            <view class="cultivator-head"></view>
            <view class="cultivator-body"></view>
            <view class="cultivator-arm arm-left"></view>
            <view class="cultivator-arm arm-right"></view>
            <view class="cultivator-leg leg-left"></view>
            <view class="cultivator-leg leg-right"></view>
            <view class="cultivator-cushion"></view>
          </view>
        </view>
        <text class="idle-title">静坐吐纳中</text>
        <text class="idle-subtitle">事件刷新会落在修士下方，像一卷缓慢展开的手札</text>
      </view>
      <view class="log-container">
        <view wx:for="{{logs}}" wx:key="idx" class="log-entry">{{item}}</view>
      </view>
      <view id="log-end"></view>
    </scroll-view>
  </view>

  <view wx:if="{{uiState === 'await_decision'}}" class="content-area">
    <scroll-view scroll-y style="flex:1;">
      <view class="event-card">
        <view class="event-header">
          <text class="event-title">{{triggerTitle}}</text>
          <text class="event-countdown {{decisionCountdown <= 10 ? 'urgent' : ''}}">⏳ {{decisionCountdown}}s</text>
        </view>
        <view class="event-description">{{triggerDescription}}</view>
        <view class="event-footer-corners">
          <text>◆</text>
          <text>◆</text>
        </view>
      </view>

      <view class="decision-area">
        <button
          wx:for="{{triggerOptions}}"
          wx:key="id"
          class="btn-gold decision-btn"
          data-id="{{item.id}}"
          bindtap="onChooseOption"
        >{{item.label}}</button>
      </view>

      <button wx:if="{{!showCustomInput}}" class="free-input-toggle" bindtap="onChooseCustom">
        自 由 对 线 · 对 天 道 说 点 什 么
      </button>

      <view wx:if="{{showCustomInput}}" class="custom-input-area">
        <textarea
          class="custom-textarea"
          value="{{customText}}"
          placeholder="在此书写你的天道谏言..."
          maxlength="200"
          bindinput="onCustomInput"
          auto-height
        />
        <view class="custom-input-btns">
          <button class="btn-dark" bindtap="onCancelCustom">收 回</button>
          <button class="btn-gold" bindtap="onSendCustom">直 谏 天 道</button>
        </view>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{uiState === 'streaming'}}" class="content-area">
    <scroll-view class="log-container story-scroll" scroll-y>
      <view class="stream-shell">
        <view class="stream-eyebrow">{{triggerTitle}}</view>
        <view class="stream-title-card" wx:if="{{streamEventTitle}}">
          <text class="stream-title-text">{{streamEventTitle}}</text>
        </view>
        <view class="story-area">
          <view class="story-section-label">因由</view>
          <text class="story-text">{{storyText}}</text>
          <text wx:if="{{isStreaming}}" class="typing-cursor"></text>
        </view>
        <view class="stream-verdict-card" wx:if="{{streamVerdict}}">
          <view class="story-section-label verdict-label">裁决</view>
          <text class="stream-verdict-text">{{streamVerdict}}</text>
        </view>
      </view>
    </scroll-view>
    <view class="streaming-hint">
      <text>{{streamHint}}</text>
    </view>
  </view>

  <view wx:if="{{uiState === 'settlement'}}" class="content-area">
    <scroll-view scroll-y style="flex:1;">
      <view class="settlement-panel">
        <view class="settlement-header">裁决回响</view>
        <view class="settlement-title" wx:if="{{streamEventTitle}}">{{streamEventTitle}}</view>
        <view class="settlement-reason" wx:if="{{settlementReason}}">{{settlementReason}}</view>
        <view class="settlement-verdict">{{settlementVerdict}}</view>
        <view class="settlement-return" wx:if="{{returnHint}}">
          <text>{{returnHint}}</text>
          <text wx:if="{{returnCountdown > 0}}">{{returnCountdown}}s</text>
        </view>
        <view class="settlement-points" wx:if="{{heavenPointsEarned > 0}}">
          天道点 +{{heavenPointsEarned}}
        </view>
        <view class="karma-submit-panel">
          <view class="story-section-label">因果偷渡</view>
          <textarea
            class="karma-textarea"
            value="{{karmaMessage}}"
            placeholder="给后来者留一句话，不写也会由天道代笔..."
            maxlength="80"
            bindinput="onKarmaMessageInput"
            auto-height
          />
          <view class="karma-effect-row">
            <button class="karma-effect {{karmaEffectType === 'mislead' ? 'active' : ''}}" data-effect="mislead" bindtap="onSelectKarmaEffect">误导</button>
            <button class="karma-effect {{karmaEffectType === 'taunt_infection' ? 'active' : ''}}" data-effect="taunt_infection" bindtap="onSelectKarmaEffect">嘴硬</button>
            <button class="karma-effect {{karmaEffectType === 'blessing' ? 'active' : ''}}" data-effect="blessing" bindtap="onSelectKarmaEffect">馈赠</button>
          </view>
          <button class="btn-dark karma-submit-btn" disabled="{{karmaSubmitted}}" bindtap="onSubmitKarmaTrace">
            {{karmaSubmitted ? '已 偷 渡' : '偷 渡 因 果'}}
          </button>
          <text wx:if="{{karmaSubmitStatus}}" class="karma-submit-status">{{karmaSubmitStatus}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{uiState === 'game_over'}}" class="content-area">
    <scroll-view scroll-y style="flex:1;">
      <view class="settlement-panel game-over-panel">
        <view class="game-over-icon">✦</view>
        <view class="game-over-title">{{epitaphTitle || '道陨'}}</view>
        <view wx:if="{{leaderboardType}}" class="epitaph-board">
          <text>{{leaderboardType}}</text>
          <text>评分 {{leaderboardScore}}</text>
        </view>
        <view class="settlement-title" wx:if="{{streamEventTitle}}">{{streamEventTitle}}</view>
        <view class="settlement-reason" wx:if="{{settlementReason}}">{{settlementReason}}</view>
        <view class="settlement-verdict">{{settlementVerdict}}</view>
        <view class="next-goal-hint" wx:if="{{nextGoalHint}}">{{nextGoalHint}}</view>
        <view class="settlement-points" wx:if="{{heavenPointsEarned > 0}}">
          天道点 +{{heavenPointsEarned}}
        </view>
      </view>
    </scroll-view>
    <button class="btn-gold new-game-btn" bindtap="onNewGame">再 入 仙 途</button>
  </view>

  <view wx:if="{{shieldRescueActive}}" class="shield-rescue-overlay">
    <view class="shield-ring ring-a"></view>
    <view class="shield-ring ring-b"></view>
    <view class="shield-seal">赦</view>
    <view class="shield-title">因 果 逆 转</view>
    <view class="shield-text">{{shieldRescueText}}</view>
  </view>
</view>
