<!-- 名人堂 · 飞升碑林 -->
<view class="page">
  <!-- 墨韵背景层 -->
  <view class="bg-veil"></view>

  <!-- 中心内容 -->
  <view class="teaser-container">
    <!-- 碑文圆环 -->
    <view class="stele-circle">
      <view class="stele-inner">
        <text class="stele-glyph">仙</text>
      </view>
    </view>

    <!-- 标题 -->
    <view class="teaser-header">
      <text class="teaser-title">名 人 堂</text>
      <text class="teaser-subtitle">— 飞 升 碑 林 —</text>
    </view>

    <!-- 分隔符 -->
    <view class="divider-rune">
      <text class="divider-line">━ ◈ ━</text>
    </view>

    <!-- 描述 -->
    <view class="teaser-body">
      <text class="teaser-desc">碑林尚无铭文</text>
      <text class="teaser-hint">静待首位飞升者刻下不朽之名...</text>
    </view>

    <!-- 空碑位 -->
    <view class="stele-slots">
      <view class="stele-slot">
        <text class="slot-rank">壹</text>
        <view class="slot-line"></view>
        <text class="slot-empty">虚位以待</text>
      </view>
      <view class="stele-slot">
        <text class="slot-rank">贰</text>
        <view class="slot-line"></view>
        <text class="slot-empty">虚位以待</text>
      </view>
      <view class="stele-slot">
        <text class="slot-rank">叁</text>
        <view class="slot-line"></view>
        <text class="slot-empty">虚位以待</text>
      </view>
    </view>
  </view>
</view>
