/**
 * 天道不正经 — 全局样式（修仙暗黑风）
 */

/* ── CSS 变量 ── */
page {
  --bg-primary: #0f0f23;
  --bg-secondary: #1a1a2e;
  --bg-card: #242442;
  --text-primary: #e0d5b7;
  --text-secondary: #8892a4;
  --text-muted: #555;
  --accent-gold: #c9a96e;
  --accent-red: #c0392b;
  --accent-green: #27ae60;
  --accent-blue: #4a6fa5;
  --border-color: #2d2d4a;
  --border-glow: #c9a96e40;

  background-color: var(--bg-primary);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC",
               "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* ── 通用组件 ── */

/* 暗色卡片 */
.card {
  background-color: var(--bg-card);
  border: 1rpx solid var(--border-color);
  border-radius: 12rpx;
  padding: 24rpx;
  margin: 16rpx 0;
}

/* 金色按钮 */
.btn-gold {
  background: linear-gradient(135deg, #8b6914, #c9a96e, #8b6914);
  color: #1a1a2e;
  border: none;
  border-radius: 8rpx;
  padding: 16rpx 32rpx;
  font-size: 30rpx;
  font-weight: bold;
  text-align: center;
}

.btn-gold:active {
  opacity: 0.85;
}

/* 暗色按钮 */
.btn-dark {
  background-color: var(--bg-secondary);
  color: var(--text-primary);
  border: 1rpx solid var(--border-color);
  border-radius: 8rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  text-align: center;
}

.btn-dark:active {
  border-color: var(--accent-gold);
}

/* 危险按钮 */
.btn-danger {
  background-color: var(--accent-red);
  color: #fff;
  border: none;
  border-radius: 8rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  text-align: center;
}

/* 状态栏 */
.status-bar {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background-color: var(--bg-secondary);
  border-bottom: 1rpx solid var(--border-color);
}

.status-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 100rpx;
}

.status-label {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.status-value {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--accent-gold);
}

/* 滚动日志容器 */
.log-container {
  flex: 1;
  overflow-y: auto;
  padding: 16rpx 24rpx;
}

.log-entry {
  padding: 8rpx 0;
  border-bottom: 1rpx solid var(--border-color);
  font-size: 26rpx;
  color: var(--text-secondary);
  word-break: break-all;
}

.log-entry:last-child {
  border-bottom: none;
}

/* 打字机光标闪烁 */
.typing-cursor::after {
  content: "▏";
  color: var(--accent-gold);
  animation: blink 1s step-end infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

/* 故事文本区 */
.story-area {
  background-color: var(--bg-secondary);
  border: 1rpx solid var(--border-glow);
  border-radius: 8rpx;
  padding: 20rpx;
  margin: 16rpx 0;
  font-size: 28rpx;
  line-height: 1.8;
  min-height: 120rpx;
}

/* 结算面板 */
.settlement-panel {
  background: linear-gradient(180deg, var(--bg-card), var(--bg-secondary));
  border: 1rpx solid var(--accent-gold);
  border-radius: 12rpx;
  padding: 24rpx;
  margin: 16rpx 0;
}

/* 加载指示器 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  color: var(--text-secondary);
}
