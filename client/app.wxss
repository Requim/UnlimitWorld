/**
 * 天道不正经 — 全局样式（水墨宇宙 · 白宣纸水墨美学）
 */

/* ═══════════════════════════════════════════
   设计令牌 — 墨色层次体系
   ═══════════════════════════════════════════ */
page {
  /* 宣纸基底层 */
  --void-deep: #e9e3d7;
  --ink-black: #f7f3ea;
  --ink-blue: #f1ebdf;
  --ink-navy: #e8e1d3;

  /* 纸面色层（宣纸层叠） */
  --paper-dark: #ffffff;
  --paper-mid: #f8f4ec;
  --paper-light: #efe7d9;

  /* 金箔体系 */
  --gold-bright: #e8c45a;
  --gold-leaf: #c9a050;
  --gold-dim: #8b6d38;
  --gold-pale: #9a8458;

  /* 朱砂体系（天谴/危险） */
  --cinnabar: #d43d3d;
  --cinnabar-bright: #f04a4a;
  --cinnabar-dark: #7a1818;
  --cinnabar-dim: #5c1010;

  /* 青玉体系（修为/生机） */
  --jade: #5aae82;
  --jade-light: #7cc9a0;
  --jade-dark: #3a7054;

  /* 文字色 */
  --text-parchment: #463d31;
  --text-parchment-light: #2f281f;
  --text-mist: #6f6558;
  --text-mist-dim: #94897b;
  --text-void: #b8aea2;

  /* 边框/分隔 */
  --border-ink: #d8cfc2;
  --border-ink-light: #cfc4b5;
  --border-gold-glow: rgba(200, 160, 80, 0.3);
  --border-cinnabar-glow: rgba(212, 61, 61, 0.22);

  /* 阴影 */
  --shadow-card: 0 10rpx 28rpx rgba(98, 82, 58, 0.08);
  --shadow-gold: 0 0 24rpx rgba(200, 160, 80, 0.08);
  --shadow-cinnabar: 0 0 20rpx rgba(212, 61, 61, 0.1);

  /* 间距 */
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;

  /* 圆角 */
  --radius-sm: 6rpx;
  --radius-md: 10rpx;
  --radius-lg: 16rpx;

  background-color: var(--ink-black);
  color: var(--text-parchment);
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei",
               "STSong", "SimSun", serif;
  font-size: 28rpx;
  line-height: 1.7;
}

/* ═══════════════════════════════════════════
   墨渍纹理背景（CSS 渐变模拟水墨晕染）
   ═══════════════════════════════════════════ */
.ink-bg {
  position: relative;
  background:
    radial-gradient(ellipse 88% 58% at 18% 82%, rgba(126, 118, 104, 0.14) 0%, transparent 60%),
    radial-gradient(ellipse 62% 38% at 84% 16%, rgba(172, 160, 141, 0.13) 0%, transparent 58%),
    radial-gradient(circle 130rpx at 16% 44%, rgba(88, 79, 67, 0.08) 0%, transparent 72%),
    radial-gradient(circle 100rpx at 76% 70%, rgba(122, 110, 90, 0.08) 0%, transparent 68%),
    linear-gradient(180deg, #fbf8f2 0%, #f4eee4 100%);
}

.ink-bg::after {
  content: "";
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
  background:
    repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2rpx,
      rgba(140, 124, 96, 0.035) 2rpx,
      rgba(140, 124, 96, 0.035) 4rpx
    );
}

/* ═══════════════════════════════════════════
   通用组件 — 卡片
   ═══════════════════════════════════════════ */
.card {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(248, 244, 236, 0.95));
  border: 1rpx solid var(--border-ink-light);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  margin: var(--space-sm) 0;
  box-shadow: var(--shadow-card);
  position: relative;
}

/* 金边卡片（天道事件） */
.card-gold {
  border-color: rgba(200, 160, 80, 0.4);
  box-shadow: var(--shadow-card), var(--shadow-gold);
}

.card-gold::before {
  content: "";
  position: absolute;
  top: -1rpx;
  left: 20rpx;
  right: 20rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--gold-dim), var(--gold-leaf), var(--gold-dim), transparent);
}

/* 朱砂边卡片（天谴/死亡） */
.card-cinnabar {
  border-color: rgba(212, 61, 61, 0.28);
  box-shadow: var(--shadow-card), var(--shadow-cinnabar);
}

.card-cinnabar::before {
  content: "";
  position: absolute;
  top: -1rpx;
  left: 20rpx;
  right: 20rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--cinnabar-dark), var(--cinnabar), var(--cinnabar-dark), transparent);
}

/* ═══════════════════════════════════════════
   通用组件 — 按钮体系
   ═══════════════════════════════════════════ */

/* 金箔主按钮 */
.btn-gold {
  background: linear-gradient(160deg, #b69252, #e0c184 48%, #f2dfb0 52%, #dec08a 62%, #b69252);
  color: #3c3226;
  border: 1rpx solid rgba(200, 160, 80, 0.5);
  border-radius: var(--radius-sm);
  padding: 18rpx 36rpx;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  letter-spacing: 4rpx;
  box-shadow: 0 2rpx 16rpx rgba(180, 140, 60, 0.2);
  position: relative;
}

.btn-gold:active {
  background: linear-gradient(160deg, #c09d5b, #e6cb94 48%, #f5e4b8 52%, #e3c88f 62%, #c09d5b);
  box-shadow: 0 1rpx 8rpx rgba(180, 140, 60, 0.22);
  transform: scale(0.97);
}

/* 暗色次按钮 */
.btn-dark {
  background: rgba(255, 255, 255, 0.88);
  color: var(--text-mist);
  border: 1rpx solid var(--border-ink-light);
  border-radius: var(--radius-sm);
  padding: 18rpx 36rpx;
  font-size: 28rpx;
  text-align: center;
  letter-spacing: 2rpx;
}

.btn-dark:active {
  border-color: var(--gold-dim);
  color: var(--gold-pale);
  background: rgba(248, 244, 236, 0.96);
}

/* 朱砂危险按钮 */
.btn-danger {
  background: linear-gradient(160deg, #c27f73, #d99a8f 46%, #eab4aa 54%, #d18d81 62%, #b97167);
  color: #fffaf7;
  border: 1rpx solid rgba(212, 61, 61, 0.4);
  border-radius: var(--radius-sm);
  padding: 18rpx 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  letter-spacing: 2rpx;
}

.btn-danger:active {
  box-shadow: 0 0 20rpx rgba(212, 61, 61, 0.25);
  transform: scale(0.97);
}

/* ═══════════════════════════════════════════
   状态栏
   ═══════════════════════════════════════════ */
.status-bar {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
  padding: 14rpx 16rpx;
  background: linear-gradient(180deg, rgba(255, 252, 246, 0.96) 0%, rgba(245, 239, 228, 0.98) 100%);
  border-bottom: 1rpx solid var(--border-ink-light);
  position: relative;
}

.status-bar::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, var(--gold-dim) 20%, var(--gold-leaf) 50%, var(--gold-dim) 80%, transparent);
  opacity: 0.5;
}

.status-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 100rpx;
  padding: 6rpx 8rpx;
}

.status-label {
  font-size: 20rpx;
  color: var(--text-mist-dim);
  letter-spacing: 2rpx;
}

.status-value {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--gold-pale);
  letter-spacing: 1rpx;
}

/* ═══════════════════════════════════════════
   日志滚动区
   ═══════════════════════════════════════════ */
.log-container {
  flex: 1;
  overflow-y: auto;
  padding: 16rpx 24rpx;
}

.log-entry {
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(30, 36, 64, 0.5);
  font-size: 26rpx;
  color: var(--text-mist);
  word-break: break-all;
  line-height: 1.6;
  letter-spacing: 1rpx;
}

.log-entry:last-child {
  border-bottom: none;
}

/* ═══════════════════════════════════════════
   故事/结算共享样式
   ═══════════════════════════════════════════ */

/* 故事文卷区 */
.story-area {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(248, 244, 236, 0.96) 100%);
  border: 1rpx solid var(--border-gold-glow);
  border-radius: var(--radius-sm);
  padding: 24rpx;
  margin: 16rpx 0;
  font-size: 30rpx;
  line-height: 1.9;
  min-height: 120rpx;
  letter-spacing: 1rpx;
  position: relative;
}

/* 卷轴暗纹 */
.story-area::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  background:
    repeating-linear-gradient(
      0deg,
      transparent,
      transparent 3rpx,
      rgba(180, 160, 120, 0.012) 3rpx,
      rgba(180, 160, 120, 0.012) 6rpx
    );
  border-radius: var(--radius-sm);
}

/* 结算面板 */
.settlement-panel {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.97), rgba(247, 241, 232, 0.97));
  border: 1rpx solid var(--border-gold-glow);
  border-radius: var(--radius-lg);
  padding: var(--space-md);
  margin: var(--space-sm) 0;
  box-shadow: var(--shadow-card), var(--shadow-gold);
  position: relative;
}

/* 金边装饰 */
.settlement-panel::before {
  content: "";
  position: absolute;
  top: 0;
  left: 16rpx;
  right: 16rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--gold-dim), var(--gold-leaf), var(--gold-dim), transparent);
}

.settlement-panel::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 16rpx;
  right: 16rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--gold-dim), var(--gold-leaf), var(--gold-dim), transparent);
}

/* ═══════════════════════════════════════════
   加载指示器
   ═══════════════════════════════════════════ */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-xl);
  color: var(--text-mist);
}

/* ═══════════════════════════════════════════
   打字光标
   ═══════════════════════════════════════════ */
.typing-cursor::after {
  content: "▏";
  color: var(--gold-leaf);
  animation: qi-blink 1s step-end infinite;
}

/* ═══════════════════════════════════════════
   动画关键帧
   ═══════════════════════════════════════════ */

/* 灵气闪烁 */
@keyframes qi-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

/* 灵力脉动 */
@keyframes qi-pulse {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}

/* 金光呼吸 */
@keyframes gold-breath {
  0%, 100% {
    box-shadow: 0 0 8rpx rgba(200, 160, 80, 0.15);
  }
  50% {
    box-shadow: 0 0 24rpx rgba(200, 160, 80, 0.3);
  }
}

/* 朱砂脉动 */
@keyframes cinnabar-pulse {
  0%, 100% {
    border-color: rgba(212, 61, 61, 0.3);
    box-shadow: 0 0 6rpx rgba(212, 61, 61, 0.1);
  }
  50% {
    border-color: rgba(212, 61, 61, 0.7);
    box-shadow: 0 0 20rpx rgba(212, 61, 61, 0.25);
  }
}

/* 淡入 */
@keyframes fade-in {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 墨渍浮现 */
@keyframes ink-reveal {
  from {
    opacity: 0;
    filter: blur(8rpx);
    transform: scale(0.96);
  }
  to {
    opacity: 1;
    filter: blur(0);
    transform: scale(1);
  }
}

/* 震怒抖动 */
@keyframes tremor {
  0%, 100% { transform: translateX(0); }
  10% { transform: translateX(-4rpx); }
  30% { transform: translateX(4rpx); }
  50% { transform: translateX(-3rpx); }
  70% { transform: translateX(3rpx); }
  90% { transform: translateX(-1rpx); }
}

/* ═══════════════════════════════════════════
   工具类
   ═══════════════════════════════════════════ */

/* 灵气脉动 */
.qi-pulse {
  animation: qi-pulse 2.5s ease-in-out infinite;
}

/* 金光呼吸 */
.gold-breath {
  animation: gold-breath 3s ease-in-out infinite;
}

/* 淡入进场 */
.fade-in {
  animation: fade-in 0.5s ease-out;
}

/* 墨渍浮现（重要面板进场） */
.ink-reveal {
  animation: ink-reveal 0.7s ease-out;
}

/* 天谴震动 */
.tremor {
  animation: tremor 0.4s ease-in-out;
}

/* 文字颜色快捷类 */
.text-gold { color: var(--gold-leaf); }
.text-cinnabar { color: var(--cinnabar); }
.text-jade { color: var(--jade-light); }
.text-mist { color: var(--text-mist); }
.text-center { text-align: center; }
