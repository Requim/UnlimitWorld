# 天道不正经 — 环境变量配置模板
# 复制此文件为 .env 并填入实际值
#
# Docker Compose 部署时，MySQL/Redis 连接地址由 compose 自动覆盖，
# 此处只需填写 DEEPSEEK_API_KEY 即可。

# ── DeepSeek LLM（必填，不填则降级为本地 mock） ──
DEEPSEEK_API_KEY="sk-your-key-here"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# ── 应用环境：development / production ──
APP_ENV="production"

# ── 服务器 ──
SERVER_HOST="0.0.0.0"
SERVER_PORT=8000

# ── MySQL（Docker 部署时 compose 自动覆盖为 mysql:3306） ──
MYSQL_HOST="127.0.0.1"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="tiandao"

# ── Redis（Docker 部署时 compose 自动覆盖为 redis:6379） ──
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# ── M3 微信小程序（开发阶段留空则降级为 mock，正式上线必填） ──
WECHAT_APPID=""
WECHAT_SECRET=""
WECHAT_MSG_SEC_CHECK_ENABLED=true
